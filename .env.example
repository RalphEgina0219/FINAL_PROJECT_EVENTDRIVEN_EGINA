# Copy this file to .env and adjust the values for your machine.
NODE_ENV=development
PORT=3003
APP_TIMEZONE=Asia/Manila

# Database (Laragon MySQL defaults)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=johnvivz_crm_db
DB_USER=root
DB_PASSWORD=
DB_TIMEZONE=+08:00
DB_LOGGING=false

# Sessions: use a long random string (e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=change-me
SESSION_MAX_AGE_HOURS=8

# Case rules (fallbacks only; the live values are edited in Settings and stored in crm_settings / service_targets)
AUTO_CLOSE_DAYS=3
REOPEN_WINDOW_DAYS=7

# SLA fallbacks in hours, per priority (seed service_targets on first migration)
SLA_FIRST_RESPONSE_HOURS_URGENT=1
SLA_FIRST_RESPONSE_HOURS_HIGH=4
SLA_FIRST_RESPONSE_HOURS_MEDIUM=8
SLA_FIRST_RESPONSE_HOURS_LOW=24
SLA_RESOLUTION_HOURS_URGENT=4
SLA_RESOLUTION_HOURS_HIGH=24
SLA_RESOLUTION_HOURS_MEDIUM=48
SLA_RESOLUTION_HOURS_LOW=72

# Attachments (stored outside public/, served through an authorized route)
ATTACHMENTS_DIR=storage/attachments

# Show the demo account list on the login page (turn off for real use)
SHOW_DEMO_LOGINS=true

# --- Integration with the other JOHNVIVZ apps (docs/integration-contract.md) ---
# disabled = feature off, no calls | mock = local fixtures, records flagged is_mock, never sent anywhere | live = real API calls (P6)
INTEGRATION_HR_MODE=mock
INTEGRATION_INVENTORY_MODE=mock
INTEGRATION_ACCOUNTING_MODE=mock
HR_API_BASE_URL=http://10.0.11.141:3001 
INVENTORY_API_BASE_URL=http://10.0.14.61:3000
ACCOUNTING_API_BASE_URL=http://10.0.13.137:3002
# HMAC-SHA256 service secrets, one per connected app (never commit real values)
JVZ_SECRET_HR=
JVZ_SECRET_INVENTORY=
JVZ_SECRET_ACCOUNTING=
JVZ_CRM_INBOUND_SECRET_HR=
JVZ_CRM_INBOUND_SECRET_INVENTORY=
JVZ_CRM_INBOUND_SECRET_ACCOUNTING=
JVZ_MAX_CLOCK_SKEW_SECONDS=300

# --- Interim dialects (docs/integration-contract.md §12): how CRM talks to each app until it follows the contract ---
# They matter only when that app's mode is live. Defaults = the contract (hmac, events, contract).
# Auth per app: hmac = signed requests (JVZ_SECRET_* / JVZ_CRM_INBOUND_SECRET_*) | bearer = the app's API token in <APP>_API_TOKEN
INTEGRATION_HR_AUTH=hmac
INTEGRATION_INVENTORY_AUTH=hmac
INTEGRATION_ACCOUNTING_AUTH=hmac
# API tokens (bearer only; never commit real values). HR: made by HR with  npm run integration:key -- create crm "CRM"
# Inventory: the value of INVENTORY_INTEGRATION_TOKEN in the Inventory app's .env
HR_API_TOKEN=
INVENTORY_API_TOKEN=
ACCOUNTING_API_TOKEN=
# HR: events = HR sends events (contract) | pull = CRM reads HR's /employees and /departments every 5 minutes (JohnVivzHR)
INTEGRATION_HR_SYNC=events
# Inventory: contract | johnvivz_inventory = the Inventory app's own events (order.confirmed, sale.completed, ...) and polled outbox
INTEGRATION_INVENTORY_DIALECT=contract
# Staff sign-in (employee account flow): mock = demo accounts keep their CRM password, accounts created from HR use the mock ESS
# registry (Setup > Staff) | live = every staff sign-in is checked by JVzPay ESS (POST /auth/login, signed with JVZ_SECRET_ACCOUNTING)
INTEGRATION_ESS_LOGIN=mock
# HR department whose employees get a CRM staff account (the CRM Manager can change it under Settings > Teams & CRM Access)
CRM_DEPARTMENT_CODE=CRM

# ESS approval queue (leave, attendance correction, overtime): off until the HR/ESS contract is confirmed
APPROVALS_ENABLED=false

# --- Email (verification, password reset, staff invitations) ---
# log = nothing is sent; messages are kept in the mail_outbox table and shown under Setup > Mail Log (development)
# smtp = send through the SMTP server below (any free provider; no paid API needed)
MAIL_TRANSPORT=log
MAIL_FROM=JOHNVIVZ CRM <no-reply@johnvivz.test>
APP_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
VERIFY_TOKEN_HOURS=48
RESET_TOKEN_MINUTES=60
INVITE_TOKEN_HOURS=72
