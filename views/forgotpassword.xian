{{> auth_top heroTitle="Locked out?" heroText="No problem. We will email you a one-time link to choose a new password."}}
    <span class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-brand-100 text-brand-700">{{icon "key" "h-7 w-7"}}</span>
    {{#if done}}
    <h1 class="mt-4 text-center text-2xl font-extrabold tracking-tight text-navy-900">Check your email</h1>
    <p class="mt-2 text-center text-sm text-slate-600">If an active account uses <strong>{{email}}</strong>, we sent a link to choose a new password. The link works once and expires soon.</p>
    {{#if devMode}}<p class="mt-4 rounded-xl border border-dashed border-sky-300 bg-sky-50 px-3 py-2 text-xs text-sky-900"><strong>Development mode:</strong> no email leaves this computer (MAIL_TRANSPORT=log). The setup administrator can read the message under Setup › Mail Log.</p>{{/if}}
    {{else}}
    <h1 class="mt-4 text-center text-2xl font-extrabold tracking-tight text-navy-900">Forgot your password?</h1>
    <p class="mt-2 text-center text-sm text-slate-600">Enter the email you sign in with. We will email you a link to choose a new password.</p>
    {{#if error}}<div class="mt-4 rounded-xl border border-red-200 bg-red-50 px-4 py-2 text-sm text-red-800" role="alert">{{error}}</div>{{/if}}
    <form method="POST" action="/forgot-password" class="mt-5 space-y-4">
      <input type="hidden" name="_csrf" value="{{csrfToken}}">
      <div><label for="email" class="sr-only">Email</label>
        <div class="jvz-field"><span class="jvz-field-icon">{{icon "envelope" "h-5 w-5"}}</span><input id="email" type="email" name="email" value="{{email}}" required autocomplete="email" placeholder="Email Address"></div></div>
      <button type="submit" class="jvz-btn">Send reset link {{icon "arrowRight" "h-5 w-5"}}</button>
    </form>
    {{/if}}
    <p class="mt-5 rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-xs text-slate-700" data-ess-reset="1"><strong>JOHNVIVZ staff:</strong> you sign in to the CRM with your ESS password. To change or reset it, use ESS (Accounting app). The CRM cannot reset it.</p>
    <p class="mt-6 text-center"><a href="/login" class="text-sm font-medium text-violet-700 hover:underline">Back to sign in</a></p>
{{> auth_bottom}}
