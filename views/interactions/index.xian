{{> layout_top}}
{{> area_tabs}}
<div class="mb-3 flex flex-wrap items-center justify-between gap-2">
  <p class="text-xs text-slate-500">{{icon "lock" "inline h-3.5 w-3.5"}} Calls, visits, messages and notes with the customers in your scope. {{pagination.total}} found.</p>
  <a href="/crm/interactions/new" class="inline-flex rounded-lg bg-violet-700 px-4 py-2 text-sm font-medium text-white hover:bg-violet-800">Log interaction</a>
</div>
<form method="GET" action="/crm/interactions" class="mb-4 flex flex-wrap items-end gap-2 rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
  <div class="min-w-0 flex-1"><label class="text-xs font-medium text-slate-500" for="q">Search</label><input id="q" name="q" value="{{filters.q}}" placeholder="Subject, notes, customer name or CUS- number" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm"></div>
  <div><label class="text-xs font-medium text-slate-500" for="type">Type</label>
    <select id="type" name="type" class="mt-1 rounded-lg border border-slate-300 px-3 py-2 text-sm"><option value="">All</option>{{#each typeOptions}}<option value="{{value}}" {{#if sel}}selected{{/if}}>{{label}}</option>{{/each}}</select></div>
  <label class="flex items-center gap-2 pb-2 text-sm text-slate-600"><input type="checkbox" name="mine" value="1" {{#if filters.mine}}checked{{/if}} class="rounded border-slate-300"> Logged by me</label>
  <button class="rounded-lg bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700">Filter</button>
  {{#if hasFilters}}<a href="/crm/interactions" class="rounded-lg border border-slate-300 px-4 py-2 text-sm hover:bg-slate-50">Clear</a>{{/if}}
</form>
<section class="rounded-xl border border-slate-200 bg-white shadow-sm">
  {{#if rows.length}}
  <div class="overflow-x-auto"><table class="stack min-w-full text-sm">
    <thead class="bg-slate-50 text-left text-xs font-medium uppercase tracking-wide text-slate-500"><tr><th class="px-4 py-2">When</th><th class="px-4 py-2">Customer</th><th class="px-4 py-2">Type</th><th class="px-4 py-2">Subject</th><th class="px-4 py-2">Logged by</th></tr></thead>
    <tbody class="divide-y divide-slate-100">
    {{#each rows}}
      <tr class="hover:bg-slate-50">
        <td class="whitespace-nowrap px-4 py-3 text-slate-600">{{formatDateTime occurred_at}}</td>
        <td class="px-4 py-3"><a href="/crm/customers/{{customer_id}}" class="font-medium text-violet-700 hover:underline">{{customer_name}}</a><p class="text-xs text-slate-500">{{customer_no}}</p></td>
        <td class="px-4 py-3"><span class="inline-flex whitespace-nowrap rounded-full bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-700 ring-1 ring-inset ring-slate-500/20">{{type_label}}</span></td>
        <td class="px-4 py-3"><a href="/crm/interactions/{{id}}" class="text-slate-800 hover:underline">{{subject}}</a>{{#if case_no}} <span class="font-mono text-xs text-slate-500">{{case_no}}</span>{{/if}}{{#if is_demo}} {{demoBadge}}{{/if}}</td>
        <td class="px-4 py-3 text-slate-600">{{#if logged_by}}{{logged_by}}{{else}}System{{/if}}</td>
      </tr>
    {{/each}}
    </tbody></table></div>
  {{else}}<p class="px-6 py-10 text-center text-sm text-slate-500">No interactions found.</p>{{/if}}
  {{> pagination}}
</section>
{{> layout_bottom}}
