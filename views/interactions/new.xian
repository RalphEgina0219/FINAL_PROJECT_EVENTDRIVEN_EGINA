{{> layout_top}}
{{> area_tabs}}
{{#if errors.length}}<div class="mb-4 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800" role="alert"><ul class="list-disc pl-5">{{#each errors}}<li>{{this}}</li>{{/each}}</ul></div>{{/if}}
<form method="POST" action="/crm/interactions" class="grid max-w-3xl grid-cols-1 gap-4 rounded-xl border border-slate-200 bg-white p-5 shadow-sm sm:grid-cols-2">
  <input type="hidden" name="_csrf" value="{{csrfToken}}">
  <h2 class="font-semibold sm:col-span-2">Interaction details</h2>
  <div class="sm:col-span-2"><label class="text-sm font-medium text-slate-700" for="customer_id">Customer</label>
    <select id="customer_id" name="customer_id" required class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm"><option value="">Choose a customer…</option>{{#each customers}}<option value="{{id}}" {{#if sel}}selected{{/if}}>{{name}} ({{customer_no}})</option>{{/each}}</select>
    <p class="mt-1 text-xs text-slate-500">Only customers in your scope are listed. <a href="/crm/customers/new" class="text-violet-700 hover:underline">New customer</a></p></div>
  <div><label class="text-sm font-medium text-slate-700" for="type">Type</label>
    <select id="type" name="type" required class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm">{{#each typeOptions}}<option value="{{value}}" {{#if sel}}selected{{/if}}>{{label}}</option>{{/each}}</select></div>
  <div><label class="text-sm font-medium text-slate-700" for="direction">Who contacted whom</label>
    <select id="direction" name="direction" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm">{{#each directionOptions}}<option value="{{value}}" {{#if sel}}selected{{/if}}>{{label}}</option>{{/each}}</select>
    <p class="mt-1 text-xs text-slate-500">Not needed for an internal note.</p></div>
  <div class="sm:col-span-2"><label class="text-sm font-medium text-slate-700" for="subject">Subject</label><input id="subject" name="subject" value="{{form.subject}}" required minlength="5" maxlength="150" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm"></div>
  <div class="sm:col-span-2"><label class="text-sm font-medium text-slate-700" for="summary">What happened (optional)</label><textarea id="summary" name="summary" rows="4" maxlength="2000" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm">{{form.summary}}</textarea></div>
  <div><label class="text-sm font-medium text-slate-700" for="occurred_at">When</label><input id="occurred_at" name="occurred_at" type="datetime-local" value="{{form.occurred_at}}" required class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm"></div>
  <div><label class="text-sm font-medium text-slate-700" for="case_no">Related case (optional)</label><input id="case_no" name="case_no" value="{{form.case_no}}" maxlength="30" placeholder="JVT-20261113-0001" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 font-mono text-sm"></div>
  <div class="flex flex-wrap gap-2 sm:col-span-2">
    <button class="rounded-lg bg-violet-700 px-4 py-2 text-sm font-medium text-white hover:bg-violet-800">Save interaction</button>
    <a href="/crm/interactions" class="rounded-lg border border-slate-300 px-4 py-2 text-sm hover:bg-slate-50">Cancel</a>
  </div>
</form>
{{> layout_bottom}}
