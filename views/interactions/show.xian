{{> layout_top}}
{{> area_tabs}}
<a href="/crm/interactions" class="mb-4 inline-flex items-center gap-1 text-sm text-slate-500 hover:text-slate-700">{{icon "arrow-left" "h-4 w-4"}} Back to interactions</a>
<div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
  <section class="rounded-xl border border-slate-200 bg-white p-5 text-sm shadow-sm lg:col-span-2">
    <p class="text-xs uppercase tracking-wide text-slate-500">{{i.type_label}}</p>
    <h2 class="mt-1 text-lg font-semibold text-slate-900">{{i.subject}} {{#if i.is_demo}}{{demoBadge}}{{/if}}</h2>
    {{#if i.summary}}<p class="mt-3 whitespace-pre-line text-slate-700">{{i.summary}}</p>{{else}}<p class="mt-3 text-slate-400">No further notes.</p>{{/if}}
  </section>
  <section class="rounded-xl border border-slate-200 bg-white p-5 text-sm shadow-sm">
    <h3 class="mb-3 font-semibold">Details</h3>
    <dl class="space-y-2">
      <div class="flex justify-between gap-2"><dt class="text-slate-500">Customer</dt><dd class="text-right"><a href="/crm/customers/{{i.customer_id}}" class="font-medium text-violet-700 hover:underline">{{i.customer_name}}</a><br><span class="text-xs text-slate-500">{{i.customer_no}}</span></dd></div>
      <div class="flex justify-between gap-2"><dt class="text-slate-500">When</dt><dd>{{formatDateTime i.occurred_at}}</dd></div>
      <div class="flex justify-between gap-2"><dt class="text-slate-500">Direction</dt><dd>{{i.direction}}</dd></div>
      <div class="flex justify-between gap-2"><dt class="text-slate-500">Logged by</dt><dd>{{#if i.logged_by}}{{i.logged_by}}{{else}}System{{/if}}</dd></div>
      <div class="flex justify-between gap-2"><dt class="text-slate-500">Follow-up</dt><dd><a href="/crm/follow-ups/new?customer_id={{i.customer_id}}{{#if i.case_no}}&case_no={{i.case_no}}{{/if}}" class="text-violet-700 hover:underline">Create a task</a></dd></div>
      {{#if i.case_no}}<div class="flex justify-between gap-2"><dt class="text-slate-500">Related case</dt><dd><a href="/crm/cases/{{i.related_id}}" class="font-mono text-violet-700 hover:underline">{{i.case_no}}</a></dd></div>{{/if}}
    </dl>
  </section>
</div>
{{> layout_bottom}}
