{{> layout_top noTitle=true}}
<section class="jvz-banner mb-6 flex flex-col gap-4 p-6 sm:flex-row sm:items-center sm:justify-between sm:px-8" aria-label="Welcome">
  <div class="max-w-xl"><h1 class="text-2xl font-bold tracking-tight sm:text-3xl"><span aria-hidden="true">👋</span> Hi, {{profile.first_name}}!</h1><p class="mt-1 text-sm text-blue-100">Customer no. {{profile.customer_no}} · Have a concern about an order, product or our service? We're here to help.</p></div>
  <div class="flex flex-wrap gap-2 self-start">
    <a href="/portal/inquiries" class="inline-flex items-center gap-2 rounded-lg border border-white/40 bg-navy-900/70 px-4 py-2 font-medium text-white backdrop-blur hover:bg-navy-900/90">{{icon "question"}} Submit inquiry</a>
    <a href="/portal/cases/new" class="inline-flex items-center gap-2 rounded-lg bg-white px-4 py-2 font-medium text-violet-700 hover:bg-violet-50">{{icon "plus"}} Submit a complaint</a>
  </div>
</section>
<div class="grid grid-cols-2 gap-4 lg:grid-cols-4">
  {{> stat label="My cases" value=summary.total href="/portal/cases"}}
  {{> stat label="Active" value=summary.active_count href="/portal/cases?status=active"}}
  {{> stat label="Waiting for my reply" value=summary.waiting_count href="/portal/cases?status=waiting_for_customer" alert=summary.waiting_count}}
  {{> stat label="Resolved / Closed" value=summary.done_count href="/portal/cases?status=resolved"}}
</div>
{{#if awaitingRating.length}}
<section class="mt-6 rounded-xl border border-amber-200 bg-amber-50 p-4">
  <h2 class="flex items-center gap-2 font-semibold text-amber-900">{{icon "star"}} Rate your resolved cases</h2>
  <ul class="mt-2 space-y-1 text-sm">{{#each awaitingRating}}<li><a href="/portal/cases/{{id}}#feedback" class="text-amber-900 underline">{{case_no}}</a> — {{subject}}</li>{{/each}}</ul>
</section>
{{/if}}

<div class="mt-6 grid grid-cols-1 gap-6 lg:grid-cols-3">
  <section class="rounded-xl border border-slate-200 bg-white shadow-sm lg:col-span-2">
    <div class="flex items-center justify-between border-b border-slate-100 px-4 py-3"><h2 class="font-semibold">My recent cases</h2><a href="/portal/cases" class="text-sm text-violet-700 hover:underline">View all</a></div>
    {{> case_table cases=recent base="/portal/cases" emptyText="You haven't submitted any concerns yet."}}
  </section>
</div>

<section class="mt-6 flex flex-col gap-3 rounded-xl border border-violet-200 bg-violet-50 p-5 sm:flex-row sm:items-center sm:justify-between" id="preferences-card" aria-label="Preferences and consent">
  <div><h2 class="font-semibold text-violet-900">Preferences &amp; consent</h2><p class="text-sm text-violet-800">Choose how and when we contact you, and whether you agree to receive promotions by SMS or email. You can change your mind at any time.</p></div>
  <a href="/portal/preferences" class="inline-flex shrink-0 items-center justify-center rounded-lg bg-violet-700 px-4 py-2 text-sm font-medium text-white hover:bg-violet-800">Preferences &amp; consent</a>
</section>
<section class="mt-4 flex flex-col gap-3 rounded-xl border border-amber-200 bg-amber-50 p-5 sm:flex-row sm:items-center sm:justify-between" id="loyalty-card" aria-label="Loyalty points" data-loyalty-card="1">
  <div><p class="text-xs font-medium uppercase tracking-wide text-amber-800">JOHNVIVZ loyalty points</p><p class="mt-1 text-2xl font-semibold text-slate-900">{{loyalty.balance}} <span class="text-sm font-normal text-slate-600">points{{#if loyalty.toNext}} · {{loyalty.toNext}} more for ₱10 off{{else}} · worth {{peso loyalty.worth}}{{/if}}</span></p><p class="mt-1 text-xs text-slate-600">{{loyaltyRules}}</p></div>
  <a href="/portal/loyalty" class="inline-flex shrink-0 items-center justify-center rounded-lg border border-amber-300 bg-white px-4 py-2 text-sm font-medium text-amber-900 hover:bg-amber-100">My loyalty points</a>
</section>

<div class="mt-6 grid grid-cols-1 gap-6 lg:grid-cols-2">
  <section class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
    <h2 class="mb-1 font-semibold">My profile</h2>
    <p class="mb-4 text-xs text-slate-500">Sign-in email: {{profile.login_email}} · Member since {{formatDate profile.created_at}}</p>
    <form method="POST" action="/portal/profile" class="grid grid-cols-1 gap-3 sm:grid-cols-2">
      <input type="hidden" name="_csrf" value="{{csrfToken}}">
      <div><label class="text-sm font-medium text-slate-700" for="first_name">First name</label><input id="first_name" name="first_name" value="{{profile.first_name}}" required maxlength="80" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm"></div>
      <div><label class="text-sm font-medium text-slate-700" for="last_name">Last name</label><input id="last_name" name="last_name" value="{{profile.last_name}}" required maxlength="80" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm"></div>
      <div><label class="text-sm font-medium text-slate-700" for="mobile">Mobile</label><input id="mobile" name="mobile" value="{{profile.mobile}}" maxlength="20" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm"></div>
      <div><label class="text-sm font-medium text-slate-700" for="address">Address</label><input id="address" name="address" value="{{profile.address}}" maxlength="200" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm"></div>
      <button class="rounded-lg bg-violet-700 px-4 py-2 text-sm font-medium text-white hover:bg-violet-800 sm:col-span-2">Save profile</button>
    </form>
    <div class="mt-4 border-t border-slate-100 pt-3 text-xs text-slate-500">
      <p class="font-medium text-slate-600">Consents on record</p>
      <ul class="mt-1 space-y-0.5">{{#each profile.consents}}<li>{{consent_type}} · version {{policy_version}} · {{channel}} · {{formatDateTime granted_at}}</li>{{else}}<li>None</li>{{/each}}</ul>
    </div>
  </section>
  <section class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
    <h2 class="mb-3 font-semibold">Change password</h2>
    <form method="POST" action="/portal/password" class="space-y-3">
      <input type="hidden" name="_csrf" value="{{csrfToken}}">
      <input type="password" name="current_password" required autocomplete="current-password" placeholder="Current password" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm">
      <input type="password" name="password" required minlength="8" autocomplete="new-password" placeholder="New password (8+ characters)" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm">
      <input type="password" name="confirm_password" required minlength="8" autocomplete="new-password" placeholder="Confirm new password" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm">
      <button class="w-full rounded-lg border border-slate-300 px-4 py-2 text-sm hover:bg-slate-50">Change password</button>
    </form>
  </section>
</div>
<section class="mt-8 grid grid-cols-1 gap-6 lg:grid-cols-3" aria-label="My orders and shop">
  <div class="rounded-xl border border-slate-200 bg-white shadow-sm lg:col-span-2">
    <div class="flex items-center justify-between border-b border-slate-100 px-4 py-3"><h2 class="font-semibold">My orders</h2><a href="/portal/orders" class="text-sm text-violet-700 hover:underline">All orders</a></div>
    {{#if orders.length}}<ul class="divide-y divide-slate-100 text-sm">{{#each orders}}<li class="flex flex-wrap items-center justify-between gap-2 px-4 py-2"><span><a href="/portal/orders/{{id}}" class="font-mono font-medium text-violet-700 hover:underline">{{order_no}}</a> <span class="text-xs text-slate-500">{{status_label}} · {{payment_label}}</span></span><span class="tabular-nums">{{peso grand_total}}</span></li>{{/each}}</ul>
    {{else}}<p class="px-4 py-6 text-center text-sm text-slate-500">No orders yet. <a href="/portal/shop" class="text-violet-700 hover:underline">Browse the shop</a>.</p>{{/if}}
  </div>
  <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
    <h2 class="font-semibold">Shop</h2>
    <p class="mt-1 text-sm text-slate-600">Products, prices and stock come from our Inventory.</p>
    <p class="mt-3 text-sm"><a href="/portal/shop" class="font-medium text-violet-700 hover:underline">Browse products</a> · <a href="/portal/cart" class="font-medium text-violet-700 hover:underline">My cart</a></p>
    {{#if promos.length}}<p class="mt-3 text-xs font-medium uppercase text-slate-500">Promotions running</p><ul class="mt-1 space-y-1 text-sm">{{#each promos}}<li><span class="font-mono font-semibold">{{promo_code}}</span> · {{name}}</li>{{/each}}</ul>{{/if}}
  </div>
</section>
{{> layout_bottom}}
