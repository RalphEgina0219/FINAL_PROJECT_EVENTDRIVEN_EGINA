{{> auth_top wide=true heroTitle="Join JOHNVIVZ Today!" heroText="Create a customer account to submit inquiries and complaints, follow every update, earn loyalty points and rate the service."}}
      <h1 class="text-2xl font-extrabold tracking-tight text-navy-900">Create your account</h1>
      <p class="mt-1 text-sm text-slate-500">For JOHNVIVZ Grocery customers. Staff access comes from JOHNVIVZ HR records.</p>
      {{#if errors.length}}<ul class="mt-4 list-disc space-y-1 rounded-xl border border-red-200 bg-red-50 py-3 pl-8 pr-4 text-sm text-red-800" role="alert">{{#each errors}}<li>{{this}}</li>{{/each}}</ul>{{/if}}
      <form method="POST" action="/register" class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2">
        <input type="hidden" name="_csrf" value="{{csrfToken}}">
        <div><label class="mb-1 block text-sm font-medium text-slate-700" for="first_name">First name *</label><div class="jvz-field"><span class="jvz-field-icon">{{icon "user" "h-5 w-5"}}</span><input id="first_name" name="first_name" value="{{form.first_name}}" required maxlength="80" autocomplete="given-name"></div></div>
        <div><label class="mb-1 block text-sm font-medium text-slate-700" for="last_name">Last name *</label><div class="jvz-field"><span class="jvz-field-icon">{{icon "user" "h-5 w-5"}}</span><input id="last_name" name="last_name" value="{{form.last_name}}" required maxlength="80" autocomplete="family-name"></div></div>
        <div class="sm:col-span-2"><label class="mb-1 block text-sm font-medium text-slate-700" for="email">Email *</label><div class="jvz-field"><span class="jvz-field-icon">{{icon "envelope" "h-5 w-5"}}</span><input id="email" type="email" name="email" value="{{form.email}}" required autocomplete="email"></div></div>
        <div><label class="mb-1 block text-sm font-medium text-slate-700" for="mobile">Mobile number</label><div class="jvz-field"><span class="jvz-field-icon">{{icon "phone" "h-5 w-5"}}</span><input id="mobile" name="mobile" value="{{form.mobile}}" maxlength="20" placeholder="09xx xxx xxxx" autocomplete="tel"></div></div>
        <div><label class="mb-1 block text-sm font-medium text-slate-700" for="address">Address</label><div class="jvz-field"><span class="jvz-field-icon">{{icon "home" "h-5 w-5"}}</span><input id="address" name="address" value="{{form.address}}" maxlength="200" autocomplete="street-address"></div></div>
        <div><label class="mb-1 block text-sm font-medium text-slate-700" for="password">Password *</label><div class="jvz-field"><span class="jvz-field-icon">{{icon "lock" "h-5 w-5"}}</span><input id="password" type="password" name="password" required minlength="8" autocomplete="new-password"><button type="button" class="jvz-toggle" aria-label="Show password" aria-pressed="false">{{icon "eye" "h-5 w-5"}}</button></div></div>
        <div><label class="mb-1 block text-sm font-medium text-slate-700" for="confirm_password">Confirm password *</label><div class="jvz-field"><span class="jvz-field-icon">{{icon "lock" "h-5 w-5"}}</span><input id="confirm_password" type="password" name="confirm_password" required minlength="8" autocomplete="new-password"><button type="button" class="jvz-toggle" aria-label="Show password" aria-pressed="false">{{icon "eye" "h-5 w-5"}}</button></div></div>
        <label class="flex items-start gap-2 text-sm text-slate-600 sm:col-span-2"><input type="checkbox" name="consent" value="1" required {{#if form.consent}}checked{{/if}} class="mt-0.5 h-4 w-4 rounded border-slate-300 text-brand-600">
          <span>I agree to the JOHNVIVZ Data Privacy Notice and Terms of Use (version 2026-11). My consent is recorded with the date and can be withdrawn by contacting customer service.</span></label>
        <button type="submit" class="jvz-btn sm:col-span-2">{{icon "user" "h-5 w-5"}} Create account</button>
        <p class="text-center text-sm text-slate-600 sm:col-span-2">Already have an account? <a href="/login" class="font-medium text-violet-700 hover:underline">Sign in</a></p>
      </form>
{{> auth_bottom}}
