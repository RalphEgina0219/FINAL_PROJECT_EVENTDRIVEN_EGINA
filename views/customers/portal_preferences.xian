{{> layout_top}}
<a href="/portal" class="mb-4 inline-flex items-center gap-1 text-sm text-slate-500 hover:text-slate-700">{{icon "arrow-left" "h-4 w-4"}} Back to my profile</a>
{{#if errors.length}}<div class="mb-4 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800" role="alert"><ul class="list-disc pl-5">{{#each errors}}<li>{{this}}</li>{{/each}}</ul></div>{{/if}}
<form method="POST" action="/portal/preferences" class="grid max-w-2xl grid-cols-1 gap-4 rounded-xl border border-slate-200 bg-white p-5 shadow-sm sm:grid-cols-2">
  <input type="hidden" name="_csrf" value="{{csrfToken}}">
  <div class="sm:col-span-2"><h2 class="font-semibold">How should we contact you?</h2><p class="text-xs text-slate-500">Service messages about your orders and cases are always sent. Promotions are sent only if you agree.</p></div>
  {{#each fields}}
  <div><label class="text-sm font-medium text-slate-700" for="pref-{{key}}">{{label}}</label>
    {{#if free}}<input id="pref-{{key}}" name="{{key}}" value="{{value}}" maxlength="{{max}}" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm">
    {{else}}<select id="pref-{{key}}" name="{{key}}" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm"><option value="">No preference</option>{{#each options}}<option value="{{value}}" {{#if sel}}selected{{/if}}>{{label}}</option>{{/each}}</select>{{/if}}
  </div>
  {{/each}}
  <fieldset class="rounded-lg border border-slate-200 bg-slate-50 p-3 sm:col-span-2"><legend class="px-1 text-sm font-medium text-slate-700">Promotions</legend>
    <label class="flex items-center gap-2 text-sm"><input type="checkbox" name="marketing_sms" value="1" {{#if marketing.marketing_sms}}checked{{/if}} class="rounded border-slate-300"> I agree to receive promotions by SMS</label>
    <label class="mt-1 flex items-center gap-2 text-sm"><input type="checkbox" name="marketing_email" value="1" {{#if marketing.marketing_email}}checked{{/if}} class="rounded border-slate-300"> I agree to receive promotions by email</label>
    <p class="mt-2 text-xs text-slate-500">You can change your mind at any time. Each change is recorded.</p>
  </fieldset>
  <div class="flex gap-2 sm:col-span-2"><button class="rounded-lg bg-violet-700 px-4 py-2 text-sm font-medium text-white hover:bg-violet-800">Save preferences</button><a href="/portal" class="rounded-lg border border-slate-300 px-4 py-2 text-sm hover:bg-slate-50">Cancel</a></div>
</form>
{{> layout_bottom}}
