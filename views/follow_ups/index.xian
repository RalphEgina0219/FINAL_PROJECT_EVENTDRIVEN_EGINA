{{> layout_top}}
{{> area_tabs}}
<div class="mb-4 grid grid-cols-2 gap-3 sm:grid-cols-4">
  {{> stat label="Pending" value=summary.pending href="/crm/follow-ups?status=pending"}}
  {{> stat label="Due today or earlier" value=summary.today href="/crm/follow-ups?status=today"}}
  {{> stat label="Overdue" value=summary.overdue href="/crm/follow-ups?status=overdue" alert=summary.overdue}}
  <div class="flex items-center justify-end">{{#if canCreate}}<a href="/crm/follow-ups/new" class="inline-flex rounded-lg bg-violet-700 px-4 py-2 text-sm font-medium text-white hover:bg-violet-800">New follow-up</a>{{/if}}</div>
</div>
<form method="GET" action="/crm/follow-ups" class="mb-4 flex flex-wrap items-end gap-2 rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
  <div class="min-w-0 flex-1"><label class="text-xs font-medium text-slate-500" for="q">Search</label><input id="q" name="q" value="{{filters.q}}" placeholder="Task, notes, customer or case number" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm"></div>
  <div><label class="text-xs font-medium text-slate-500" for="status">Status</label><select id="status" name="status" class="mt-1 rounded-lg border border-slate-300 px-3 py-2 text-sm"><option value="">All</option>{{#each statusOptions}}<option value="{{value}}" {{#if sel}}selected{{/if}}>{{label}}</option>{{/each}}</select></div>
  <div><label class="text-xs font-medium text-slate-500" for="priority">Priority</label><select id="priority" name="priority" class="mt-1 rounded-lg border border-slate-300 px-3 py-2 text-sm"><option value="">All</option>{{#each priorityOptions}}<option value="{{value}}" {{#if sel}}selected{{/if}}>{{label}}</option>{{/each}}</select></div>
  {{#if isSupervisor}}<div><label class="text-xs font-medium text-slate-500" for="assignee">Assigned to</label><select id="assignee" name="assignee" class="mt-1 rounded-lg border border-slate-300 px-3 py-2 text-sm"><option value="">Anyone</option>{{#each staff}}<option value="{{id}}" {{#if sel}}selected{{/if}}>{{name}}</option>{{/each}}</select></div>{{/if}}
  <button class="rounded-lg bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700">Filter</button>
  {{#if hasFilters}}<a href="/crm/follow-ups" class="rounded-lg border border-slate-300 px-4 py-2 text-sm hover:bg-slate-50">Clear</a>{{/if}}
</form>
<p class="mb-2 text-xs text-slate-500">{{scopeNote}}</p>
<section class="rounded-xl border border-slate-200 bg-white shadow-sm">
  {{#if rows.length}}
  <div class="overflow-x-auto"><table class="stack min-w-full text-sm">
    <thead class="bg-slate-50 text-left text-xs font-medium uppercase tracking-wide text-slate-500"><tr><th class="px-4 py-2">Task</th><th class="px-4 py-2">Customer</th><th class="px-4 py-2">Due</th><th class="px-4 py-2">Priority</th><th class="px-4 py-2">Status</th><th class="px-4 py-2">Assigned to</th></tr></thead>
    <tbody class="divide-y divide-slate-100">
    {{#each rows}}
      <tr class="hover:bg-slate-50">
        <td class="px-4 py-3"><a href="/crm/follow-ups/{{id}}" class="font-medium text-violet-700 hover:underline">{{title}}</a> {{#if is_demo}}{{demoBadge}}{{/if}}{{#if case_no}}<p class="font-mono text-xs text-slate-500">{{case_no}}</p>{{/if}}</td>
        <td class="px-4 py-3"><a href="/crm/customers/{{customer_id}}" class="hover:underline">{{customer_name}}</a><p class="text-xs text-slate-500">{{customer_no}}</p></td>
        <td class="whitespace-nowrap px-4 py-3 {{#if is_overdue}}font-semibold text-red-600{{else}}text-slate-600{{/if}}">{{formatDateTime due_at}}</td>
        <td class="px-4 py-3 text-slate-600">{{priority}}</td>
        <td class="px-4 py-3"><span class="inline-flex whitespace-nowrap rounded-full px-2 py-0.5 text-xs font-medium ring-1 ring-inset {{#if (eq state "overdue")}}bg-red-50 text-red-700 ring-red-600/20{{else}}{{#if (eq state "done")}}bg-emerald-50 text-emerald-700 ring-emerald-600/20{{else}}{{#if (eq state "cancelled")}}bg-slate-100 text-slate-600 ring-slate-500/20{{else}}bg-amber-50 text-amber-800 ring-amber-600/20{{/if}}{{/if}}{{/if}}">{{state_label}}</span></td>
        <td class="px-4 py-3 text-slate-600">{{assignee_name}}</td>
      </tr>
    {{/each}}
    </tbody></table></div>
  {{else}}<p class="px-6 py-10 text-center text-sm text-slate-500">No follow-ups found.</p>{{/if}}
  {{> pagination}}
</section>
{{> layout_bottom}}
