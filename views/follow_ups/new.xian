{{> layout_top}}
{{> area_tabs}}
{{#if errors.length}}<div class="mb-4 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800" role="alert"><ul class="list-disc pl-5">{{#each errors}}<li>{{this}}</li>{{/each}}</ul></div>{{/if}}
<form method="POST" action="/crm/follow-ups" class="grid max-w-3xl grid-cols-1 gap-4 rounded-xl border border-slate-200 bg-white p-5 shadow-sm sm:grid-cols-2">
  <input type="hidden" name="_csrf" value="{{csrfToken}}">
  <h2 class="font-semibold sm:col-span-2">Follow-up details</h2>
  <div class="sm:col-span-2"><label class="text-sm font-medium text-slate-700" for="customer_id">Customer</label>
    <select id="customer_id" name="customer_id" required class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm"><option value="">Choose a customer…</option>{{#each customers}}<option value="{{id}}" {{#if sel}}selected{{/if}}>{{name}} ({{customer_no}})</option>{{/each}}</select></div>
  <div class="sm:col-span-2"><label class="text-sm font-medium text-slate-700" for="title">Task</label><input id="title" name="title" value="{{form.title}}" required minlength="5" maxlength="150" placeholder="For example: Call back about the replacement order" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm"></div>
  <div><label class="text-sm font-medium text-slate-700" for="due_at">Due</label><input id="due_at" name="due_at" type="datetime-local" value="{{form.due_at}}" required class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm"></div>
  <div><label class="text-sm font-medium text-slate-700" for="priority">Priority</label><select id="priority" name="priority" required class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm">{{#each priorityOptions}}<option value="{{value}}" {{#if sel}}selected{{/if}}>{{label}}</option>{{/each}}</select></div>
  {{#if canPickAssignee}}
  <div><label class="text-sm font-medium text-slate-700" for="assigned_to">Assign to</label><select id="assigned_to" name="assigned_to" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm">{{#each staff}}<option value="{{id}}" {{#if sel}}selected{{/if}}>{{name}}{{#if self}} (you){{/if}} — {{role}}</option>{{/each}}</select></div>
  {{else}}<p class="self-end text-xs text-slate-500">The task is assigned to you.</p>{{/if}}
  <div><label class="text-sm font-medium text-slate-700" for="case_no">Related case (optional)</label><input id="case_no" name="case_no" value="{{form.case_no}}" maxlength="30" placeholder="JVT-20261113-0001" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 font-mono text-sm"></div>
  <div class="sm:col-span-2"><label class="text-sm font-medium text-slate-700" for="notes">Notes (optional)</label><textarea id="notes" name="notes" rows="3" maxlength="1000" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm">{{form.notes}}</textarea></div>
  <div class="flex flex-wrap gap-2 sm:col-span-2"><button class="rounded-lg bg-violet-700 px-4 py-2 text-sm font-medium text-white hover:bg-violet-800">Save follow-up</button><a href="/crm/follow-ups" class="rounded-lg border border-slate-300 px-4 py-2 text-sm hover:bg-slate-50">Cancel</a></div>
</form>
{{> layout_bottom}}
