{{> layout_top}}
{{> area_tabs}}
{{#if errors.length}}<div class="mb-4 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800" role="alert"><ul class="list-disc pl-5">{{#each errors}}<li>{{this}}</li>{{/each}}</ul></div>{{/if}}
<form method="POST" action="/crm/inquiries" class="grid max-w-3xl grid-cols-1 gap-4 rounded-xl border border-slate-200 bg-white p-5 shadow-sm sm:grid-cols-2">
  <input type="hidden" name="_csrf" value="{{csrfToken}}">
  <div class="sm:col-span-2"><h2 class="font-semibold">Record an inquiry</h2><p class="text-xs text-slate-500">For a question that reached us by phone, in the store, by SMS, social media or email. Customers who use the portal submit their own.</p></div>
  <div class="sm:col-span-2"><label class="text-sm font-medium text-slate-700" for="customer_id">Customer</label>
    <select id="customer_id" name="customer_id" required class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm"><option value="">Choose a customer…</option>{{#each customers}}<option value="{{id}}" {{#if sel}}selected{{/if}}>{{name}} ({{customer_no}})</option>{{/each}}</select>
    <p class="mt-1 text-xs text-slate-500">Only customers in your scope are listed. <a href="/crm/customers/new" class="text-violet-700 hover:underline">New customer</a></p></div>
  <div><label class="text-sm font-medium text-slate-700" for="channel">Received by</label>
    <select id="channel" name="channel" required class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm">{{#each channelOptions}}<option value="{{value}}" {{#if sel}}selected{{/if}}>{{label}}</option>{{/each}}</select></div>
  <div><label class="text-sm font-medium text-slate-700" for="subject">Subject</label><input id="subject" name="subject" value="{{form.subject}}" required minlength="5" maxlength="150" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm"></div>
  <div class="sm:col-span-2"><label class="text-sm font-medium text-slate-700" for="question">The question</label><textarea id="question" name="question" rows="4" required minlength="10" maxlength="3000" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm">{{form.question}}</textarea></div>
  <div class="sm:col-span-2"><label class="text-sm font-medium text-slate-700" for="answer">Answer given on the spot (optional)</label><textarea id="answer" name="answer" rows="3" maxlength="2000" minlength="{{minAnswer}}" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm">{{form.answer}}</textarea>
    <p class="mt-1 text-xs text-slate-500">Leave it empty to answer later. The inquiry is also added to the customer's interaction timeline. You become its handler.</p></div>
  <div class="flex flex-wrap gap-2 sm:col-span-2"><button class="rounded-lg bg-violet-700 px-4 py-2 text-sm font-medium text-white hover:bg-violet-800">Save inquiry</button><a href="/crm/inquiries" class="rounded-lg border border-slate-300 px-4 py-2 text-sm hover:bg-slate-50">Cancel</a></div>
</form>
{{> layout_bottom}}
