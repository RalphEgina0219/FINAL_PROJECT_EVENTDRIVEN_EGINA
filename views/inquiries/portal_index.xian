{{> layout_top}}
<div class="grid grid-cols-1 gap-6 lg:grid-cols-5">
  <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm lg:col-span-2">
    <h2 class="font-semibold">Ask a question</h2>
    <p class="mb-4 mt-1 text-sm text-slate-500">About a product, our branches, payments or your account. We answer here and notify you. For a problem with an order, <a href="/portal/cases/new" class="text-violet-700 hover:underline">submit a complaint</a> instead.</p>
    {{#if errors.length}}<ul class="mb-4 list-disc space-y-1 rounded-lg border border-red-200 bg-red-50 py-3 pl-8 pr-4 text-sm text-red-800" role="alert">{{#each errors}}<li>{{this}}</li>{{/each}}</ul>{{/if}}
    <form method="POST" action="/portal/inquiries" class="space-y-3">
      <input type="hidden" name="_csrf" value="{{csrfToken}}">
      <div><label class="block text-sm font-medium text-slate-700" for="subject">Subject *</label><input id="subject" name="subject" value="{{form.subject}}" required minlength="5" maxlength="150" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></div>
      <div><label class="block text-sm font-medium text-slate-700" for="question">Your question *</label><textarea id="question" name="question" rows="6" required minlength="10" maxlength="3000" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2">{{form.question}}</textarea></div>
      <button class="rounded-lg bg-violet-700 px-5 py-2.5 font-medium text-white hover:bg-violet-800">Send inquiry</button>
    </form>
  </section>
  <section class="rounded-xl border border-slate-200 bg-white shadow-sm lg:col-span-3">
    <div class="border-b border-slate-100 px-4 py-3"><h2 class="font-semibold">My inquiries</h2></div>
    {{#if inquiries.length}}
    <ul class="divide-y divide-slate-100 text-sm">
      {{#each inquiries}}
      <li class="px-4 py-3"><div class="flex flex-wrap items-center justify-between gap-2"><a href="/portal/inquiries/{{id}}" class="font-medium text-violet-700 hover:underline">{{subject}}</a>
        <span class="inline-flex whitespace-nowrap rounded-full px-2 py-0.5 text-xs font-medium ring-1 ring-inset {{#if (eq status "answered")}}bg-emerald-50 text-emerald-700 ring-emerald-600/20{{else}}{{#if (eq status "open")}}bg-amber-50 text-amber-800 ring-amber-600/20{{else}}bg-slate-100 text-slate-700 ring-slate-500/20{{/if}}{{/if}}">{{#if (eq status "open")}}Waiting for an answer{{else}}{{status_label}}{{/if}}</span></div>
        <p class="font-mono text-xs text-slate-500">{{inquiry_no}} · {{formatDateTime created_at}}</p></li>
      {{/each}}
    </ul>
    {{else}}<p class="px-6 py-10 text-center text-sm text-slate-500">You have not asked anything yet.</p>{{/if}}
  </section>
</div>
{{> layout_bottom}}
