{{> layout_top}}
{{> area_tabs}}
<a href="/crm/inquiries" class="mb-4 inline-flex items-center gap-1 text-sm text-slate-500 hover:text-slate-700">{{icon "arrow-left" "h-4 w-4"}} Back to inquiries</a>
<div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
  <div class="space-y-6 lg:col-span-2">
    <section class="rounded-xl border border-slate-200 bg-white p-5 text-sm shadow-sm">
      <p class="font-mono text-xs text-slate-500">{{i.inquiry_no}} · {{i.channel_label}} · {{formatDateTime i.created_at}}{{#if i.is_demo}} {{demoBadge}}{{/if}}</p>
      <h2 class="mt-1 text-lg font-semibold text-slate-900">{{i.subject}}</h2>
      <p class="mt-3 whitespace-pre-line text-slate-700">{{i.question}}</p>
    </section>
    {{#if i.answer}}
    <section class="rounded-xl border border-emerald-200 bg-emerald-50 p-5 text-sm shadow-sm">
      <h3 class="font-semibold text-emerald-900">Answer</h3>
      <p class="mt-2 whitespace-pre-line text-emerald-950">{{i.answer}}</p>
      <p class="mt-2 text-xs text-emerald-800">{{#if i.handler_name}}{{i.handler_name}} · {{/if}}{{formatDateTime i.answered_at}}</p>
    </section>
    {{/if}}
    {{#if i.converted_case_no}}
    <section class="rounded-xl border border-indigo-200 bg-indigo-50 p-5 text-sm shadow-sm"><p class="text-indigo-900">Converted to case <a href="/crm/cases/{{i.converted_case_id}}" class="font-mono font-semibold underline">{{i.converted_case_no}}</a>.</p></section>
    {{/if}}
    {{#if canAnswer}}
    <section class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <h3 class="mb-2 font-semibold">Answer this inquiry</h3>
      <form method="POST" action="/crm/inquiries/{{i.id}}/answer" class="space-y-2">
        <input type="hidden" name="_csrf" value="{{csrfToken}}">
        <textarea name="answer" rows="4" required minlength="{{minAnswer}}" maxlength="2000" placeholder="Write the answer the customer will read…" aria-label="Answer" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm"></textarea>
        <button class="rounded-lg bg-violet-700 px-4 py-2 text-sm font-medium text-white hover:bg-violet-800">Send answer</button>
      </form>
    </section>
    {{/if}}
    {{#if handledByOther}}<p class="rounded-lg bg-slate-50 px-4 py-3 text-sm text-slate-600">This inquiry is handled by {{i.handler_name}}. You can read it; only the handler or a supervisor can answer it.</p>{{/if}}
  </div>

  <aside class="space-y-6">
    <section class="rounded-xl border border-slate-200 bg-white p-5 text-sm shadow-sm">
      <h3 class="mb-3 font-semibold">Details</h3>
      <dl class="space-y-2">
        <div class="flex justify-between gap-2"><dt class="text-slate-500">Status</dt><dd>{{i.status_label}}</dd></div>
        <div class="flex justify-between gap-2"><dt class="text-slate-500">Customer</dt><dd class="text-right"><a href="/crm/customers/{{i.customer_id}}" class="font-medium text-violet-700 hover:underline">{{i.customer_name}}</a><br><span class="text-xs text-slate-500">{{i.customer_no}}</span></dd></div>
        <div class="flex justify-between gap-2"><dt class="text-slate-500">Handled by</dt><dd>{{#if i.handler_name}}{{i.handler_name}}{{else}}<span class="text-amber-700">Nobody yet</span>{{/if}}</dd></div>
        {{#if i.created_by_name}}<div class="flex justify-between gap-2"><dt class="text-slate-500">Recorded by</dt><dd>{{i.created_by_name}}</dd></div>{{/if}}
      </dl>
      {{#if canTake}}<form method="POST" action="/crm/inquiries/{{i.id}}/take" class="mt-3"><input type="hidden" name="_csrf" value="{{csrfToken}}"><button class="w-full rounded-lg border border-violet-300 px-4 py-2 text-sm font-medium text-violet-700 hover:bg-violet-50">I will handle this</button></form>{{/if}}
      {{#if canFollowUp}}<p class="mt-3 text-sm"><a href="/crm/follow-ups/new?customer_id={{i.customer_id}}&title={{i.inquiry_no}}%20follow-up" class="text-violet-700 hover:underline">Create a follow-up task</a></p>{{/if}}
    </section>

    {{#if canAssign}}
    <section class="rounded-xl border border-slate-200 bg-white p-5 text-sm shadow-sm">
      <h3 class="mb-2 font-semibold">{{#if i.handler_name}}Reassign{{else}}Assign{{/if}}</h3>
      <form method="POST" action="/crm/inquiries/{{i.id}}/assign" class="space-y-2">
        <input type="hidden" name="_csrf" value="{{csrfToken}}">
        <select name="agent_id" required aria-label="Agent" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm"><option value="">Choose an agent</option>{{#each agents}}<option value="{{id}}" {{#if current}}disabled{{/if}}>{{name}} — {{team_name}} · {{active_count}} active{{#if current}} (current){{/if}}</option>{{/each}}</select>
        <button class="w-full rounded-lg bg-violet-700 px-4 py-2 text-sm font-medium text-white hover:bg-violet-800">Assign inquiry</button>
        <p class="text-xs text-slate-500">If the customer has no agent yet, the same agent also becomes the customer's agent.</p>
      </form>
    </section>
    {{/if}}

    {{#if canConvert}}
    <section class="rounded-xl border border-slate-200 bg-white p-5 text-sm shadow-sm">
      <h3 class="mb-1 font-semibold">Convert to a case</h3>
      <p class="mb-2 text-xs text-slate-500">For a question that needs real handling. The question becomes the case description; the customer is told.</p>
      <form method="POST" action="/crm/inquiries/{{i.id}}/convert" class="space-y-2" onsubmit="return confirm('Convert this inquiry to a case?');">
        <input type="hidden" name="_csrf" value="{{csrfToken}}">
        <select name="case_type" required aria-label="Type of case" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm">{{#each typeOptions}}<option value="{{value}}" {{#if sel}}selected{{/if}}>{{label}}</option>{{/each}}</select>
        <select name="category_id" required aria-label="Category" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm"><option value="">Category…</option>{{#each categories}}<option value="{{id}}">{{name}}</option>{{/each}}</select>
        <select name="priority" required aria-label="Priority" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm">{{#each priorityOptions}}<option value="{{value}}" {{#if sel}}selected{{/if}}>{{label}}</option>{{/each}}</select>
        <button class="w-full rounded-lg border border-indigo-300 px-4 py-2 text-sm font-medium text-indigo-700 hover:bg-indigo-50">Convert to case</button>
      </form>
    </section>
    {{/if}}

    {{#if canClose}}
    <section class="rounded-xl border border-slate-200 bg-white p-5 text-sm shadow-sm">
      <form method="POST" action="/crm/inquiries/{{i.id}}/close" onsubmit="return confirm('Close this inquiry?');"><input type="hidden" name="_csrf" value="{{csrfToken}}"><button class="w-full rounded-lg border border-slate-300 px-4 py-2 text-sm hover:bg-slate-50">Close inquiry</button></form>
      <p class="mt-2 text-xs text-slate-500">Nothing more to do: the customer got the answer.</p>
    </section>
    {{/if}}
  </aside>
</div>
{{> layout_bottom}}
