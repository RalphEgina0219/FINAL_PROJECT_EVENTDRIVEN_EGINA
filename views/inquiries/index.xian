{{> layout_top}}
{{> area_tabs}}
<div class="mb-4 grid grid-cols-2 gap-3 sm:grid-cols-4">
  {{> stat label="Open" value=counts.open href="/crm/inquiries?status=open" alert=counts.unclaimed hint=(concat counts.unclaimed " with no handler")}}
  {{> stat label="Answered" value=counts.answered href="/crm/inquiries?status=answered"}}
  {{> stat label="In scope" value=counts.total href="/crm/inquiries"}}
  <div class="flex items-center justify-end">{{#if canCreate}}<a href="/crm/inquiries/new" class="inline-flex rounded-lg bg-violet-700 px-4 py-2 text-sm font-medium text-white hover:bg-violet-800">Record an inquiry</a>{{/if}}</div>
</div>
<form method="GET" action="/crm/inquiries" class="mb-4 flex flex-wrap items-end gap-2 rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
  <div class="min-w-0 flex-1"><label class="text-xs font-medium text-slate-500" for="q">Search</label><input id="q" name="q" value="{{filters.q}}" placeholder="INQ- number, subject, question or customer" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm"></div>
  <div><label class="text-xs font-medium text-slate-500" for="status">Status</label><select id="status" name="status" class="mt-1 rounded-lg border border-slate-300 px-3 py-2 text-sm"><option value="">All</option>{{#each statusOptions}}<option value="{{value}}" {{#if sel}}selected{{/if}}>{{label}}</option>{{/each}}</select></div>
  <div><label class="text-xs font-medium text-slate-500" for="channel">Channel</label><select id="channel" name="channel" class="mt-1 rounded-lg border border-slate-300 px-3 py-2 text-sm"><option value="">All</option>{{#each channelOptions}}<option value="{{value}}" {{#if sel}}selected{{/if}}>{{label}}</option>{{/each}}</select></div>
  <label class="flex items-center gap-2 pb-2 text-sm text-slate-600"><input type="checkbox" name="mine" value="1" {{#if filters.mine}}checked{{/if}} class="rounded border-slate-300"> Handled by me</label>
  <button class="rounded-lg bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700">Filter</button>
  {{#if hasFilters}}<a href="/crm/inquiries" class="rounded-lg border border-slate-300 px-4 py-2 text-sm hover:bg-slate-50">Clear</a>{{/if}}
</form>
<section class="rounded-xl border border-slate-200 bg-white shadow-sm">
  {{#if rows.length}}
  <div class="overflow-x-auto"><table class="stack min-w-full text-sm">
    <thead class="bg-slate-50 text-left text-xs font-medium uppercase tracking-wide text-slate-500"><tr><th class="px-4 py-2">Inquiry</th><th class="px-4 py-2">Received</th><th class="px-4 py-2">Customer</th><th class="px-4 py-2">Channel</th><th class="px-4 py-2">Status</th><th class="px-4 py-2">Handled by</th></tr></thead>
    <tbody class="divide-y divide-slate-100">
    {{#each rows}}
      <tr class="hover:bg-slate-50">
        <td class="px-4 py-3"><a href="/crm/inquiries/{{id}}" class="font-medium text-violet-700 hover:underline">{{subject}}</a> {{#if is_demo}}{{demoBadge}}{{/if}}<p class="font-mono text-xs text-slate-500">{{inquiry_no}}</p></td>
        <td class="whitespace-nowrap px-4 py-3 text-slate-600">{{formatDateTime created_at}}</td>
        <td class="px-4 py-3">{{customer_name}}<p class="text-xs text-slate-500">{{customer_no}}</p></td>
        <td class="px-4 py-3 text-slate-600">{{channel_label}}</td>
        <td class="px-4 py-3"><span class="inline-flex whitespace-nowrap rounded-full px-2 py-0.5 text-xs font-medium ring-1 ring-inset {{#if (eq status "open")}}bg-amber-50 text-amber-800 ring-amber-600/20{{else}}{{#if (eq status "answered")}}bg-emerald-50 text-emerald-700 ring-emerald-600/20{{else}}{{#if (eq status "converted")}}bg-indigo-50 text-indigo-700 ring-indigo-600/20{{else}}bg-slate-100 text-slate-700 ring-slate-500/20{{/if}}{{/if}}{{/if}}">{{status_label}}</span>{{#if converted_case_no}} <a href="/crm/cases/{{converted_case_id}}" class="font-mono text-xs text-violet-700 hover:underline">{{converted_case_no}}</a>{{/if}}</td>
        <td class="px-4 py-3 text-slate-600">{{#if handler_name}}{{handler_name}}{{else}}<span class="text-xs text-amber-700">Nobody yet</span>{{/if}}</td>
      </tr>
    {{/each}}
    </tbody></table></div>
  {{else}}<p class="px-6 py-10 text-center text-sm text-slate-500">No inquiries found.</p>{{/if}}
  {{> pagination}}
</section>
{{> layout_bottom}}
