{{> layout_top}}
<p class="mb-3 text-sm"><a href="/portal" class="text-violet-700 hover:underline">← My Profile</a></p>
<section class="mb-6 rounded-xl border border-violet-200 bg-violet-50 p-5" data-loyalty-card="1">
  <p class="text-xs font-medium uppercase tracking-wide text-violet-700">JOHNVIVZ loyalty points</p>
  <p class="mt-1 text-3xl font-semibold text-slate-900">{{loyalty.balance}} <span class="text-base font-normal text-slate-600">points</span></p>
  {{#if loyalty.toNext}}<p class="mt-1 text-sm text-slate-700" data-to-next="1"><strong>{{loyalty.toNext}}</strong> more point(s) and you can take ₱10 off an order.</p>{{else}}<p class="mt-1 text-sm text-slate-700">Worth <strong>{{peso loyalty.worth}}</strong> off your next order. Choose "Use loyalty points" when you check out.</p>{{/if}}
  <p class="mt-3 text-xs text-slate-600">{{rules}}</p>
</section>
<section class="rounded-xl border border-slate-200 bg-white shadow-sm">
  <h2 class="border-b border-slate-100 px-4 py-3 font-semibold text-slate-900">History</h2>
  {{#if loyalty.transactions.length}}
  <div class="overflow-x-auto"><table class="stack min-w-full text-sm">
    <thead class="bg-slate-50 text-left text-xs font-medium uppercase tracking-wide text-slate-500"><tr><th class="px-4 py-2">When</th><th class="px-4 py-2">What</th><th class="px-4 py-2 text-right">Points</th><th class="px-4 py-2">Details</th></tr></thead>
    <tbody class="divide-y divide-slate-100">
    {{#each loyalty.transactions}}<tr data-txn="{{txn_type}}"><td class="whitespace-nowrap px-4 py-2 text-xs text-slate-500">{{formatDateTime created_at}}</td><td class="px-4 py-2">{{label}}</td><td class="px-4 py-2 text-right font-medium tabular-nums {{#if (gt points 0)}}text-emerald-700{{else}}text-red-700{{/if}}">{{#if (gt points 0)}}+{{/if}}{{points}}</td><td class="px-4 py-2 text-xs text-slate-600">{{reason}}</td></tr>{{/each}}
    </tbody></table></div>
  {{else}}<p class="px-6 py-10 text-center text-sm text-slate-500">No points yet. You earn points when an order is completed.</p>{{/if}}
</section>
{{> layout_bottom}}
