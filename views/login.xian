{{> auth_top}}
      <h1 class="text-center text-2xl font-extrabold tracking-tight text-navy-900">Welcome Back!</h1>
      <p class="mt-1 text-center text-sm text-slate-500">Sign in to your JOHNVIVZ CRM account</p>
      {{#if loggedOut}}<div class="mt-4 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-2 text-sm text-emerald-800">You have been signed out.</div>{{/if}}
      <div class="mt-4">{{> flash}}</div>
      {{#if error}}<div class="mb-4 rounded-xl border border-red-200 bg-red-50 px-4 py-2 text-sm text-red-800" role="alert">{{error}}</div>{{/if}}
      {{#if unverified}}<form method="POST" action="/verify-email/resend" class="mb-4 -mt-2"><input type="hidden" name="_csrf" value="{{csrfToken}}"><input type="hidden" name="email" value="{{email}}"><button type="submit" class="text-sm font-medium text-violet-700 underline">Send me a new confirmation email</button></form>{{/if}}
      <form method="POST" action="/login" class="space-y-4">
        <input type="hidden" name="_csrf" value="{{csrfToken}}">
        <div><label for="email" class="sr-only">Email</label>
          <div class="jvz-field"><span class="jvz-field-icon">{{icon "envelope" "h-5 w-5"}}</span>
            <input id="email" type="email" name="email" value="{{email}}" required autocomplete="email" placeholder="Email Address"></div></div>
        <div><label for="password" class="sr-only">Password</label>
          <div class="jvz-field"><span class="jvz-field-icon">{{icon "lock" "h-5 w-5"}}</span>
            <input id="password" type="password" name="password" required autocomplete="current-password" placeholder="Password">
            <button type="button" class="jvz-toggle" aria-label="Show password" aria-pressed="false">{{icon "eye" "h-5 w-5"}}</button></div></div>
        <div class="flex items-center justify-between text-sm"><a href="/register" class="font-medium text-violet-700 hover:underline">Create a customer account</a><a href="/forgot-password" class="font-medium text-violet-700 hover:underline">Forgot password?</a></div>
        <p class="text-xs text-slate-500" data-ess-hint="1">Staff: sign in with your work email and your ESS password.</p>
        <button type="submit" class="jvz-btn">Sign in {{icon "arrowRight" "h-5 w-5"}}</button>
      </form>
      <p class="mt-4 text-center text-xs text-slate-500">CRM staff, customers and the setup administrator all sign in here.</p>

      {{#if demoAccounts.length}}
      <div class="mt-6 rounded-2xl border border-dashed border-sky-300 bg-sky-50 p-4">
        <p class="text-sm font-semibold text-sky-900">Demo accounts (demo data)</p>
        <p class="text-xs text-sky-800">Password for all: <code class="rounded bg-white px-1">{{demoPassword}}</code>. Staff come from the <strong>mock HR fixture</strong>. Click an account to fill in the form.</p>
        <ul class="mt-2 divide-y divide-sky-200 text-sm">
          {{#each demoAccounts}}
          <li><button type="button" data-email="{{email}}" class="demo-fill flex w-full items-center justify-between gap-2 py-1.5 text-left hover:text-sky-900"><span class="truncate">{{email}}</span><span class="shrink-0 text-xs text-sky-700">{{this.roleLabel}}{{#if team_name}} · {{team_name}}{{/if}}{{#if blocked}} · <span class="text-red-600">HR: {{employmentLabel employment_status}}</span>{{/if}}</span></button></li>
          {{/each}}
        </ul>
      </div>
      <script>
        document.querySelectorAll('.demo-fill').forEach(function (b) { b.addEventListener('click', function () {
          document.getElementById('email').value = b.dataset.email; document.getElementById('password').value = '{{demoPassword}}'; }); });
      </script>
      {{/if}}
{{> auth_bottom}}
