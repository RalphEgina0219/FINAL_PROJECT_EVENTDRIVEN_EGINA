{{> auth_top heroTitle="One more step." heroText="Confirm your email address to activate your JOHNVIVZ customer account."}}
    <span class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-brand-100 text-brand-700">{{icon "envelope" "h-7 w-7"}}</span>
    <h1 class="mt-4 text-center text-2xl font-extrabold tracking-tight text-navy-900">{{#if resent}}Check your email{{else}}One more step{{/if}}</h1>
    {{#if resent}}
    <p class="mt-2 text-center text-sm text-slate-600">If <strong>{{email}}</strong> belongs to an account that is waiting for confirmation, we sent a new link.</p>
    {{#if devMode}}<p class="mt-4 rounded-xl border border-dashed border-sky-300 bg-sky-50 px-3 py-2 text-left text-xs text-sky-900"><strong>Development mode:</strong> no email leaves this computer. The setup administrator can read it under Setup › Mail Log.</p>{{/if}}
    {{else}}
    <p class="mt-2 text-center text-sm text-slate-600">Your customer account <strong>{{customerNo}}</strong> is created. We sent a confirmation link to <strong>{{email}}</strong>. Open it to activate the account, then sign in.</p>
    {{#if devLink}}<p class="mt-4 rounded-xl border border-dashed border-sky-300 bg-sky-50 px-3 py-2 text-left text-xs text-sky-900"><strong>Development mode:</strong> no email leaves this computer (MAIL_TRANSPORT=log), so the link is shown here instead: <a href="{{devLink}}" class="break-all font-medium underline">Confirm my email</a></p>{{/if}}
    {{/if}}
    <p class="mt-6 text-center"><a href="/login" class="text-sm font-medium text-violet-700 hover:underline">Back to sign in</a></p>
{{> auth_bottom}}
