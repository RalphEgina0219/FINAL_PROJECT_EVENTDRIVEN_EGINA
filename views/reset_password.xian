{{> auth_top heroTitle="Almost there." heroText="Choose a strong password to keep your JOHNVIVZ account safe."}}
    <span class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-brand-100 text-brand-700">{{icon "key" "h-7 w-7"}}</span>
    {{#if invalid}}
    <h1 class="mt-4 text-center text-2xl font-extrabold tracking-tight text-navy-900">This link is no longer valid</h1>
    <p class="mt-2 text-center text-sm text-slate-600">It may have expired or already been used. Request a new one and try again.</p>
    <p class="mt-6"><a href="/forgot-password" class="jvz-btn">Request a new link</a></p>
    {{else}}
    <h1 class="mt-4 text-center text-2xl font-extrabold tracking-tight text-navy-900">{{#if invite}}Set your password{{else}}Choose a new password{{/if}}</h1>
    <p class="mt-2 text-center text-sm text-slate-600">{{name}}, use at least 8 characters. After saving, any other signed-in session of yours ends.</p>
    {{#if errors.length}}<ul class="mt-4 list-disc space-y-1 rounded-xl border border-red-200 bg-red-50 py-3 pl-8 pr-4 text-sm text-red-800" role="alert">{{#each errors}}<li>{{this}}</li>{{/each}}</ul>{{/if}}
    <form method="POST" action="/reset-password/{{token}}" class="mt-5 space-y-4">
      <input type="hidden" name="_csrf" value="{{csrfToken}}">
      <div><label for="password" class="mb-1 block text-sm font-medium text-slate-700">New password</label>
        <div class="jvz-field"><span class="jvz-field-icon">{{icon "lock" "h-5 w-5"}}</span><input id="password" type="password" name="password" required minlength="8" maxlength="72" autocomplete="new-password"><button type="button" class="jvz-toggle" aria-label="Show password" aria-pressed="false">{{icon "eye" "h-5 w-5"}}</button></div></div>
      <div><label for="confirm_password" class="mb-1 block text-sm font-medium text-slate-700">Confirm new password</label>
        <div class="jvz-field"><span class="jvz-field-icon">{{icon "lock" "h-5 w-5"}}</span><input id="confirm_password" type="password" name="confirm_password" required minlength="8" maxlength="72" autocomplete="new-password"><button type="button" class="jvz-toggle" aria-label="Show password" aria-pressed="false">{{icon "eye" "h-5 w-5"}}</button></div></div>
      <button type="submit" class="jvz-btn">Save password</button>
    </form>
    {{/if}}
    <p class="mt-6 text-center"><a href="/login" class="text-sm font-medium text-violet-700 hover:underline">Back to sign in</a></p>
{{> auth_bottom}}
