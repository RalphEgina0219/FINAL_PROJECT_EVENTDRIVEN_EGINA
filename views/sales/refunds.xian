{{> layout_top}}
{{> area_tabs}}
<div class="mb-4 grid grid-cols-2 gap-3 sm:grid-cols-4">
  {{> stat label="Waiting for a decision" value=counts.requested href="/crm/sales/refunds?status=requested" alert=counts.requested}}
  {{> stat label="Approved, to record" value=counts.approved href="/crm/sales/refunds?status=approved"}}
</div>
<p class="mb-3 text-xs text-slate-500">A refund is requested from a completed sale's page. The approver must be a different person from the requester.</p>
<form method="GET" action="/crm/sales/refunds" class="mb-4 flex flex-wrap items-end gap-2 rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
  <div class="min-w-0 flex-1"><label class="text-xs font-medium text-slate-500" for="q">Search</label><input id="q" name="q" value="{{filters.q}}" placeholder="RFD / SO / SALE number or customer" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm"></div>
  <div><label class="text-xs font-medium text-slate-500" for="status">Status</label><select id="status" name="status" class="mt-1 rounded-lg border border-slate-300 px-3 py-2 text-sm"><option value="">All</option>{{#each statusOptions}}<option value="{{value}}" {{#if sel}}selected{{/if}}>{{label}}</option>{{/each}}</select></div>
  <button class="rounded-lg bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700">Filter</button>
  {{#if hasFilters}}<a href="/crm/sales/refunds" class="rounded-lg border border-slate-300 px-4 py-2 text-sm hover:bg-slate-50">Clear</a>{{/if}}
</form>
<section class="rounded-xl border border-slate-200 bg-white shadow-sm">
  {{#if rows.length}}
  <div class="overflow-x-auto"><table class="stack min-w-full text-sm">
    <thead class="bg-slate-50 text-left text-xs font-medium uppercase tracking-wide text-slate-500"><tr><th class="px-4 py-2">Refund</th><th class="px-4 py-2">Order / sale</th><th class="px-4 py-2">Customer</th><th class="px-4 py-2 text-right">Amount</th><th class="px-4 py-2">Status</th><th class="px-4 py-2">Requested by</th><th class="px-4 py-2">Date</th></tr></thead>
    <tbody class="divide-y divide-slate-100">
    {{#each rows}}
      <tr class="hover:bg-slate-50">
        <td class="px-4 py-3"><a href="/crm/sales/refunds/{{id}}" class="font-mono font-medium text-violet-700 hover:underline">{{refund_no}}</a> {{#if is_demo}}{{demoBadge}}{{/if}}</td>
        <td class="px-4 py-3"><a href="/crm/sales/orders/{{order_id}}" class="font-mono text-xs hover:underline">{{order_no}}</a><p class="font-mono text-xs text-slate-500">{{transaction_no}}</p></td>
        <td class="px-4 py-3">{{customer_name}}<p class="text-xs text-slate-500">{{customer_no}}</p></td>
        <td class="px-4 py-3 text-right tabular-nums">{{peso amount}}</td>
        <td class="px-4 py-3"><span class="inline-flex whitespace-nowrap rounded-full px-2 py-0.5 text-xs font-medium ring-1 ring-inset {{#if (eq status "recorded")}}bg-emerald-50 text-emerald-700 ring-emerald-600/20{{else}}{{#if (eq status "rejected")}}bg-slate-100 text-slate-600 ring-slate-500/20{{else}}bg-amber-50 text-amber-800 ring-amber-600/20{{/if}}{{/if}}">{{status_label}}</span></td>
        <td class="px-4 py-3 text-slate-600">{{requested_by_name}}</td>
        <td class="whitespace-nowrap px-4 py-3 text-slate-600">{{formatDate created_at}}</td>
      </tr>
    {{/each}}
    </tbody></table></div>
  {{else}}<p class="px-6 py-10 text-center text-sm text-slate-500">No refunds found.</p>{{/if}}
  {{> pagination}}
</section>
{{> layout_bottom}}
