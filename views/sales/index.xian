{{> layout_top}}
{{> area_tabs}}
{{> inventory_note}}
<div class="mb-4 grid grid-cols-2 gap-3 sm:grid-cols-4">
  {{> stat label="In progress" value=summary.in_progress href="/crm/sales?status=confirmed"}}
  {{> stat label="Awaiting payment" value=summary.awaiting_payment href="/crm/sales?payment=unpaid" alert=summary.awaiting_payment}}
  {{> stat label="Payments to verify" value=summary.to_verify href="/crm/sales/payments?status=recorded" alert=summary.to_verify}}
  <div class="flex flex-col items-end justify-center gap-2">
    {{#if canCreate}}<a href="/crm/sales/new" class="inline-flex rounded-lg bg-violet-700 px-4 py-2 text-sm font-medium text-white hover:bg-violet-800">New order</a>{{/if}}
    {{#if canSync}}<form method="POST" action="/crm/sales/sync"><input type="hidden" name="_csrf" value="{{csrfToken}}"><button class="text-xs text-slate-500 underline hover:text-slate-700">Refresh product snapshot from Inventory</button></form>{{/if}}
  </div>
</div>
<form method="GET" action="/crm/sales" class="mb-4 flex flex-wrap items-end gap-2 rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
  <div class="min-w-0 flex-1"><label class="text-xs font-medium text-slate-500" for="q">Search</label><input id="q" name="q" value="{{filters.q}}" placeholder="SO / SALE number, customer name or CUS- number" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm"></div>
  <div><label class="text-xs font-medium text-slate-500" for="status">Status</label><select id="status" name="status" class="mt-1 rounded-lg border border-slate-300 px-3 py-2 text-sm"><option value="">All</option>{{#each statusOptions}}<option value="{{value}}" {{#if sel}}selected{{/if}}>{{label}}</option>{{/each}}</select></div>
  <div><label class="text-xs font-medium text-slate-500" for="payment">Payment</label><select id="payment" name="payment" class="mt-1 rounded-lg border border-slate-300 px-3 py-2 text-sm"><option value="">All</option>{{#each paymentOptions}}<option value="{{value}}" {{#if sel}}selected{{/if}}>{{label}}</option>{{/each}}</select></div>
  <div><label class="text-xs font-medium text-slate-500" for="channel">Channel</label><select id="channel" name="channel" class="mt-1 rounded-lg border border-slate-300 px-3 py-2 text-sm"><option value="">All</option>{{#each channelOptions}}<option value="{{value}}" {{#if sel}}selected{{/if}}>{{label}}</option>{{/each}}</select></div>
  <label class="flex items-center gap-2 pb-2 text-sm text-slate-600"><input type="checkbox" name="mine" value="1" {{#if filters.mine}}checked{{/if}} class="rounded border-slate-300"> My orders</label>
  <button class="rounded-lg bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700">Filter</button>
  {{#if hasFilters}}<a href="/crm/sales" class="rounded-lg border border-slate-300 px-4 py-2 text-sm hover:bg-slate-50">Clear</a>{{/if}}
</form>
<section class="rounded-xl border border-slate-200 bg-white shadow-sm">
  {{#if rows.length}}
  <div class="overflow-x-auto"><table class="stack min-w-full text-sm">
    <thead class="bg-slate-50 text-left text-xs font-medium uppercase tracking-wide text-slate-500"><tr><th class="px-4 py-2">Order</th><th class="px-4 py-2">Customer</th><th class="px-4 py-2">Channel</th><th class="px-4 py-2 text-right">Total</th><th class="px-4 py-2">Status</th><th class="px-4 py-2">Payment</th><th class="px-4 py-2">Agent</th><th class="px-4 py-2">Created</th></tr></thead>
    <tbody class="divide-y divide-slate-100">
    {{#each rows}}
      <tr class="hover:bg-slate-50">
        <td class="px-4 py-3"><a href="/crm/sales/orders/{{id}}" class="font-mono font-medium text-violet-700 hover:underline">{{order_no}}</a> {{#if is_demo}}{{demoBadge}}{{/if}}{{#if transaction_no}}<p class="font-mono text-xs text-slate-500">{{transaction_no}}</p>{{/if}}</td>
        <td class="px-4 py-3">{{customer_name}}<p class="text-xs text-slate-500">{{customer_no}}</p></td>
        <td class="px-4 py-3 text-slate-600">{{channel_label}}<p class="text-xs text-slate-500">{{fulfillment_label}}</p></td>
        <td class="px-4 py-3 text-right tabular-nums">{{peso grand_total}}</td>
        <td class="px-4 py-3"><span class="inline-flex whitespace-nowrap rounded-full px-2 py-0.5 text-xs font-medium ring-1 ring-inset {{#if (eq status "completed")}}bg-emerald-50 text-emerald-700 ring-emerald-600/20{{else}}{{#if (eq status "cancelled")}}bg-slate-100 text-slate-600 ring-slate-500/20{{else}}bg-indigo-50 text-indigo-700 ring-indigo-600/20{{/if}}{{/if}}">{{status_label}}</span></td>
        <td class="px-4 py-3 text-slate-600">{{payment_label}}</td>
        <td class="px-4 py-3 text-slate-600">{{#if agent_name}}{{agent_name}}{{else}}<span class="text-xs text-amber-700">—</span>{{/if}}</td>
        <td class="whitespace-nowrap px-4 py-3 text-slate-600">{{formatDate created_at}}</td>
      </tr>
    {{/each}}
    </tbody></table></div>
  {{else}}<p class="px-6 py-10 text-center text-sm text-slate-500">No orders found.</p>{{/if}}
  {{> pagination}}
</section>
{{> layout_bottom}}
