{{> layout_top}}
{{> area_tabs}}
<a href="/crm/sales/refunds" class="mb-4 inline-flex items-center gap-1 text-sm text-slate-500 hover:text-slate-700">{{icon "arrow-left" "h-4 w-4"}} Back to refunds</a>
<div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
  <section class="rounded-xl border border-slate-200 bg-white p-5 text-sm shadow-sm lg:col-span-2">
    <div class="flex flex-wrap items-center gap-2"><span class="font-mono text-base font-semibold">{{r.refund_no}}</span><span class="rounded-full bg-amber-50 px-2 py-0.5 text-xs font-medium text-amber-800 ring-1 ring-inset ring-amber-600/20">{{r.status_label}}</span>{{#if r.is_demo}}{{demoBadge}}{{/if}}</div>
    <p class="mt-3 text-2xl font-semibold tabular-nums">{{peso r.amount}}</p>
    <p class="mt-1 text-slate-600">of the sale {{peso r.sale_net}} · <a href="/crm/sales/orders/{{r.order_id}}" class="font-mono text-violet-700 hover:underline">{{r.order_no}}</a> · <span class="font-mono">{{r.transaction_no}}</span></p>
    <h3 class="mt-4 font-semibold">Reason</h3><p class="text-slate-700">{{r.reason}}</p>
    {{#if r.case_no}}<p class="mt-2 text-slate-600">Related case <a href="/crm/cases/{{r.case_id}}" class="font-mono text-violet-700 hover:underline">{{r.case_no}}</a></p>{{/if}}
    {{#if items.length}}<h3 class="mt-4 font-semibold">Items coming back to Inventory</h3><ul class="mt-1 space-y-1 text-slate-700">{{#each items}}<li><span class="font-mono text-xs">{{product_id}}</span> × {{quantity}} · {{condition_label}}</li>{{/each}}</ul>{{/if}}
    {{#if r.decision_reason}}<p class="mt-3 rounded-lg bg-slate-50 px-3 py-2 text-slate-700">Decision note: {{r.decision_reason}}</p>{{/if}}
  </section>
  <aside class="space-y-6">
    <section class="rounded-xl border border-slate-200 bg-white p-5 text-sm shadow-sm">
      <h3 class="mb-3 font-semibold">Details</h3>
      <dl class="space-y-2">
        <div class="flex justify-between gap-2"><dt class="text-slate-500">Customer</dt><dd class="text-right"><a href="/crm/customers/{{r.customer_id}}" class="font-medium text-violet-700 hover:underline">{{r.customer_name}}</a><br><span class="text-xs text-slate-500">{{r.customer_no}}</span></dd></div>
        <div class="flex justify-between gap-2"><dt class="text-slate-500">Requested by</dt><dd>{{r.requested_by_name}}</dd></div>
        <div class="flex justify-between gap-2"><dt class="text-slate-500">Requested</dt><dd>{{formatDateTime r.created_at}}</dd></div>
        {{#if r.approved_by_name}}<div class="flex justify-between gap-2"><dt class="text-slate-500">Decided by</dt><dd>{{r.approved_by_name}}</dd></div>{{/if}}
        {{#if r.recorded_at}}<div class="flex justify-between gap-2"><dt class="text-slate-500">Recorded</dt><dd>{{formatDateTime r.recorded_at}}</dd></div>{{/if}}
      </dl>
    </section>
    {{#if canDecide}}
    <section class="rounded-xl border border-slate-200 bg-white p-5 text-sm shadow-sm"><h3 class="mb-2 font-semibold">Decide</h3>
      <form method="POST" action="/crm/sales/refunds/{{r.id}}/decide" class="space-y-2"><input type="hidden" name="_csrf" value="{{csrfToken}}">
        <input name="reason" maxlength="255" placeholder="Note (required to reject)" aria-label="Note" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm">
        <div class="flex gap-2"><button name="decision" value="approve" class="flex-1 rounded-lg bg-emerald-600 px-3 py-2 text-sm font-medium text-white hover:bg-emerald-700">Approve</button><button name="decision" value="reject" class="flex-1 rounded-lg border border-red-300 px-3 py-2 text-sm text-red-700 hover:bg-red-50">Reject</button></div></form>
    </section>
    {{else}}{{#if ownRequest}}<p class="rounded-lg bg-slate-50 px-4 py-3 text-sm text-slate-600">You requested this refund, so someone else must decide it.</p>{{/if}}{{/if}}
    {{#if canRecord}}
    <section class="rounded-xl border border-emerald-200 bg-emerald-50 p-5 text-sm shadow-sm"><h3 class="font-semibold text-emerald-900">Record the refund</h3><p class="mb-2 text-xs text-emerald-800">Do this once the money was returned to the customer. It sends RefundRecorded once.</p>
      <form method="POST" action="/crm/sales/refunds/{{r.id}}/record" onsubmit="return confirm('Record this refund?');"><input type="hidden" name="_csrf" value="{{csrfToken}}"><button class="w-full rounded-lg bg-emerald-600 px-4 py-2 text-sm font-medium text-white hover:bg-emerald-700">Record refund</button></form></section>
    {{/if}}
  </aside>
</div>
{{> layout_bottom}}
