{{> layout_top}}
{{> area_tabs}}
{{> inventory_note}}
{{#if errors.length}}<div class="mb-4 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800" role="alert"><ul class="list-disc pl-5">{{#each errors}}<li>{{this}}</li>{{/each}}</ul></div>{{/if}}
{{#unless customer}}
<form method="GET" action="/crm/sales/new" class="max-w-xl space-y-3 rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
  <h2 class="font-semibold">Step 1: choose the customer</h2>
  <select name="customer_id" required aria-label="Customer" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm"><option value="">Choose a customer…</option>{{#each customers}}<option value="{{id}}" {{#if sel}}selected{{/if}}>{{name}} ({{customer_no}})</option>{{/each}}</select>
  <p class="text-xs text-slate-500">Only customers in your scope are listed. <a href="/crm/customers/new" class="text-violet-700 hover:underline">New customer</a></p>
  <button class="rounded-lg bg-violet-700 px-4 py-2 text-sm font-medium text-white hover:bg-violet-800">Continue</button>
</form>
{{else}}
<form method="POST" action="/crm/sales" class="space-y-6">
  <input type="hidden" name="_csrf" value="{{csrfToken}}">
  <input type="hidden" name="request_key" value="{{requestKey}}">
  <input type="hidden" name="customer_id" value="{{customer.id}}">
  <section class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
    <h2 class="font-semibold">Order for {{customer.first_name}} {{customer.last_name}} <span class="font-mono text-xs text-slate-500">{{customer.customer_no}}</span></h2>
    <div class="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-3">
      <div><label class="text-sm font-medium text-slate-700" for="channel">Received by</label><select id="channel" name="channel" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm">{{#each channelOptions}}<option value="{{value}}" {{#if sel}}selected{{/if}}>{{label}}</option>{{/each}}</select></div>
      <div><label class="text-sm font-medium text-slate-700" for="fulfillment">Fulfilment</label><select id="fulfillment" name="fulfillment" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm">{{#each fulfillmentOptions}}<option value="{{value}}" {{#if sel}}selected{{/if}}>{{label}}</option>{{/each}}</select></div>
      <div><label class="text-sm font-medium text-slate-700" for="address_id">Delivery address</label><select id="address_id" name="address_id" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm"><option value="">Not for delivery</option>{{#each addresses}}<option value="{{id}}" {{#if sel}}selected{{/if}}>{{#if label}}{{label}}: {{/if}}{{line1}}{{#if city_municipality}}, {{city_municipality}}{{/if}}</option>{{/each}}</select></div>
    </div>
    {{#unless addresses.length}}<p class="mt-2 text-xs text-amber-700">This customer has no address yet. <a href="/crm/customers/{{customer.id}}#addresses" class="underline">Add one</a> before a delivery order.</p>{{/unless}}
  </section>
  <section class="rounded-xl border border-slate-200 bg-white shadow-sm">
    <div class="border-b border-slate-100 px-4 py-3"><h2 class="font-semibold">Products</h2><p class="text-xs text-slate-500">Enter a quantity for each product you want. Prices come from Inventory and cannot be changed here. They are checked again when you place the order.</p></div>
    <div class="overflow-x-auto"><table class="stack min-w-full text-sm">
      <thead class="bg-slate-50 text-left text-xs font-medium uppercase tracking-wide text-slate-500"><tr><th class="px-4 py-2">Product</th><th class="px-4 py-2 text-right">Price</th><th class="px-4 py-2 text-right">Available</th><th class="px-4 py-2 text-right">Quantity</th></tr></thead>
      <tbody class="divide-y divide-slate-100">
      {{#each products}}
        <tr><td class="px-4 py-2">{{name}}<p class="font-mono text-xs text-slate-500">{{sku}} · {{category_name}}</p></td>
          <td class="px-4 py-2 text-right tabular-nums">{{peso selling_price}} <span class="text-xs text-slate-500">/ {{unit}}</span><input type="hidden" name="price_{{product_id}}" value="{{selling_price}}"></td>
          <td class="px-4 py-2 text-right tabular-nums">{{#if out}}<span class="text-red-600">Out of stock</span>{{else}}{{available_qty}}{{#if low_stock}} <span class="text-xs text-amber-700">low</span>{{/if}}{{/if}}</td>
          <td class="px-4 py-2 text-right"><input name="qty_{{product_id}}" value="{{qty}}" inputmode="decimal" {{#if out}}disabled{{/if}} aria-label="Quantity of {{name}}" class="w-24 rounded-lg border border-slate-300 px-2 py-1 text-right text-sm"></td></tr>
      {{/each}}
      </tbody></table></div>
  </section>
  <section class="grid grid-cols-1 gap-4 rounded-xl border border-slate-200 bg-white p-5 shadow-sm sm:grid-cols-4">
    <div><label class="text-sm font-medium text-slate-700" for="promo_code">Promo code (optional)</label><input id="promo_code" name="promo_code" value="{{form.promo_code}}" maxlength="30" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 font-mono text-sm uppercase">{{#if promos.length}}<p class="mt-1 text-xs text-slate-500">Active: {{#each promos}}<span class="font-mono">{{promo_code}}</span>{{#unless @last}}, {{/unless}}{{/each}}</p>{{/if}}</div>
    {{#if loyalty}}<div data-loyalty-redeem="1"><label class="text-sm font-medium text-slate-700" for="loyalty_points">Customer's loyalty points ({{loyalty.balance}})</label><select id="loyalty_points" name="loyalty_points" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm"><option value="0">Don't use points</option>{{#each loyalty.options}}<option value="{{value}}">{{label}}</option>{{/each}}</select><p class="mt-1 text-xs text-slate-500">Only with the customer's agreement. 100 points = ₱10.</p></div>{{/if}}
    <div><label class="text-sm font-medium text-slate-700" for="payment_method">Payment now (optional)</label><select id="payment_method" name="payment_method" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm">{{#each paymentOptions}}<option value="{{value}}" {{#if sel}}selected{{/if}}>{{label}}</option>{{/each}}</select></div>
    <div><label class="text-sm font-medium text-slate-700" for="payment_reference">Reference no. (GCash / Maya, or cash receipt)</label><input id="payment_reference" name="payment_reference" value="{{form.payment_reference}}" maxlength="40" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 font-mono text-sm"></div>
    <p class="text-xs text-slate-500 sm:col-span-4">No payment gateway is connected. GCash and Maya reference numbers are typed in and must be verified by another staff member. Cash on delivery is collected and recorded when the order is delivered. VAT is computed by Accounting.</p>
  </section>
  <div class="flex flex-wrap gap-2"><button class="rounded-lg bg-violet-700 px-5 py-2.5 text-sm font-medium text-white hover:bg-violet-800">Check stock and place order</button><a href="/crm/sales" class="rounded-lg border border-slate-300 px-5 py-2.5 text-sm hover:bg-slate-50">Cancel</a></div>
</form>
{{/unless}}
{{> layout_bottom}}
