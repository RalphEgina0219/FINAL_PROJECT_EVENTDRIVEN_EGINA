{{> layout_top}}
{{> settings_tabs}}
<form method="POST" action="{{cfg.rules}}" class="max-w-4xl space-y-6">
  <input type="hidden" name="_csrf" value="{{csrfToken}}">
  <section class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
    <h2 class="mb-3 font-semibold">Case rules</h2>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      {{#each general}}<div><label class="block text-sm font-medium text-slate-700" for="{{key}}">{{label}}</label><input id="{{key}}" type="number" name="{{key}}" value="{{value}}" min="{{min}}" max="{{max}}" required class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></div>{{/each}}
    </div>
  </section>
  <section class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
    <h2 class="mb-1 font-semibold">SLA targets (service_targets)</h2>
    <p class="mb-3 text-xs text-slate-500">Hours from case creation. A change is stored as a new target that applies to new cases from now on; older targets stay on record.</p>
    <div class="overflow-x-auto"><table class="stack min-w-full text-sm">
      <thead class="text-left text-xs uppercase text-slate-500"><tr><th class="py-2 pr-4">Priority</th><th class="py-2 pr-4">First response (hours)</th><th class="py-2">Resolution (hours)</th></tr></thead>
      <tbody>{{#each sla}}<tr><td class="py-2 pr-4">{{priorityBadge priority}}</td>
        <td class="py-2 pr-4"><input type="number" name="{{first.key}}" value="{{first.value}}" min="{{first.min}}" max="{{first.max}}" required aria-label="{{first.label}}" class="w-28 rounded-lg border border-slate-300 px-3 py-1.5"></td>
        <td class="py-2"><input type="number" name="{{resolution.key}}" value="{{resolution.value}}" min="{{resolution.min}}" max="{{resolution.max}}" required aria-label="{{resolution.label}}" class="w-28 rounded-lg border border-slate-300 px-3 py-1.5"></td></tr>{{/each}}</tbody>
    </table></div>
  </section>
  <button class="rounded-lg bg-violet-700 px-5 py-2.5 text-sm font-medium text-white hover:bg-violet-800">Save settings</button>
</form>
{{> layout_bottom}}
