{{> layout_top}}
{{> settings_tabs}}
<p class="mb-3 text-xs text-slate-500">{{icon "lock" "inline h-3.5 w-3.5"}} The audit log is append-only: database triggers reject every UPDATE and DELETE, and there is no edit or delete screen.</p>
<form method="GET" action="{{cfg.audit}}" class="mb-4 flex flex-wrap items-end gap-2 rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
  <div class="min-w-0 flex-1"><label class="text-xs font-medium text-slate-500" for="q">Search</label><input id="q" name="q" value="{{q}}" placeholder="User, record or details" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm"></div>
  <div><label class="text-xs font-medium text-slate-500" for="action">Action</label><select id="action" name="action" class="mt-1 rounded-lg border border-slate-300 px-2 py-2 text-sm"><option value="">All</option>{{#each actions}}<option value="{{this}}" {{selected ../action this}}>{{this}}</option>{{/each}}</select></div>
  <div><label class="text-xs font-medium text-slate-500" for="outcome">Outcome</label><select id="outcome" name="outcome" class="mt-1 rounded-lg border border-slate-300 px-2 py-2 text-sm"><option value="">All</option><option value="success" {{selected outcome "success"}}>Success</option><option value="denied" {{selected outcome "denied"}}>Denied</option><option value="failed" {{selected outcome "failed"}}>Failed</option></select></div>
  <button class="rounded-lg bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700">Filter</button>
</form>
<section class="rounded-xl border border-slate-200 bg-white shadow-sm">
  {{#if rows.length}}
  <div class="overflow-x-auto"><table class="stack min-w-full text-sm">
    <thead class="bg-slate-50 text-left text-xs font-medium uppercase tracking-wide text-slate-500"><tr><th class="px-4 py-2">When</th><th class="px-4 py-2">Actor</th><th class="px-4 py-2">Action</th><th class="px-4 py-2">Record</th><th class="px-4 py-2">Details / changes</th></tr></thead>
    <tbody class="divide-y divide-slate-100 align-top">
    {{#each rows}}
      <tr>
        <td class="whitespace-nowrap px-4 py-2 text-slate-500">{{formatDateTime created_at}}</td>
        <td class="px-4 py-2">{{#if actor_name}}{{actor_name}}{{else}}<span class="text-slate-400">System / anonymous</span>{{/if}}{{#if actor_role}}<p class="text-xs text-slate-500">{{roleLabel actor_role}}</p>{{/if}}</td>
        <td class="px-4 py-2"><span class="font-mono text-xs">{{action}}</span> {{#if (eq outcome "denied")}}<span class="rounded bg-red-50 px-1.5 text-xs text-red-700">denied</span>{{/if}}{{#if (eq outcome "failed")}}<span class="rounded bg-amber-50 px-1.5 text-xs text-amber-800">failed</span>{{/if}}</td>
        <td class="px-4 py-2 text-xs text-slate-600">{{record_type}} {{record_id}}</td>
        <td class="max-w-md px-4 py-2 text-xs text-slate-600">{{details}}{{#if reason}}<p>Reason: {{reason}}</p>{{/if}}{{#if before_text}}<p class="break-all font-mono text-slate-500">before: {{before_text}}</p>{{/if}}{{#if after_text}}<p class="break-all font-mono text-slate-700">after: {{after_text}}</p>{{/if}}{{#if ip_address}}<p class="text-slate-400">IP {{ip_address}}</p>{{/if}}</td>
      </tr>
    {{/each}}
    </tbody></table></div>
  {{else}}<p class="px-6 py-10 text-center text-sm text-slate-500">No audit entries match.</p>{{/if}}
  {{> pagination}}
</section>
{{> layout_bottom}}
