{{> layout_top}}
{{> settings_tabs}}
<div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
  <section class="space-y-3 lg:col-span-2">
    {{#each rows}}
    <article class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm {{#unless is_active}}opacity-60{{/unless}}">
      <div class="flex flex-wrap items-start justify-between gap-2">
        <div><h3 class="font-medium">{{title}}</h3><p class="text-xs text-slate-500">{{#if category_name}}{{category_name}}{{else}}All categories{{/if}}{{#unless is_active}} · inactive{{/unless}}</p></div>
        <div class="flex flex-wrap gap-2">
          <a href="{{../cfg.templates}}?edit={{id}}" class="rounded border border-slate-300 px-2 py-1 text-xs hover:bg-slate-50">Edit</a>
          <form method="POST" action="{{../cfg.templates}}/{{id}}/toggle"><input type="hidden" name="_csrf" value="{{../csrfToken}}"><button class="rounded border border-slate-300 px-2 py-1 text-xs hover:bg-slate-50">{{#if is_active}}Deactivate{{else}}Activate{{/if}}</button></form>
          <form method="POST" action="{{../cfg.templates}}/{{id}}/delete" onsubmit="return confirm('Delete this template?');"><input type="hidden" name="_csrf" value="{{../csrfToken}}"><button class="rounded border border-red-200 px-2 py-1 text-xs text-red-700 hover:bg-red-50">Delete</button></form>
        </div>
      </div>
      <p class="mt-2 whitespace-pre-line text-sm text-slate-700">{{body}}</p>
    </article>
    {{else}}<p class="rounded-xl border border-slate-200 bg-white p-6 text-center text-sm text-slate-500">No templates yet.</p>{{/each}}
  </section>
  <form method="POST" action="{{#if editing}}{{cfg.templates}}/{{editing.id}}{{else}}{{cfg.templates}}{{/if}}" class="space-y-3 self-start rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
    <input type="hidden" name="_csrf" value="{{csrfToken}}">
    <h2 class="font-semibold">{{#if editing}}Edit template{{else}}New template{{/if}}</h2>
    <input name="title" value="{{editing.title}}" required minlength="3" maxlength="100" placeholder="Title" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm">
    <select name="category_id" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm"><option value="">All categories</option>{{#each categories}}<option value="{{id}}" {{selected ../editing.category_id id}}>{{name}}</option>{{/each}}</select>
    <textarea name="body" rows="6" required minlength="10" maxlength="3000" placeholder="Message" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm">{{editing.body}}</textarea>
    <p class="text-xs text-slate-500">Placeholders: {customer_name}, {case_no}, {agent_name}, {subject}, {category}</p>
    <button class="w-full rounded-lg bg-violet-700 px-4 py-2 text-sm font-medium text-white hover:bg-violet-800">{{#if editing}}Save changes{{else}}Create template{{/if}}</button>
    {{#if editing}}<a href="{{cfg.templates}}" class="block text-center text-sm text-slate-500 hover:underline">Cancel</a>{{/if}}
  </form>
</div>
{{> layout_bottom}}
