{{> layout_top}}
<a href="/crm/cases" class="mb-4 inline-flex items-center gap-1 text-sm text-slate-500 hover:text-slate-700">{{icon "arrow-left" "h-4 w-4"}} Back to cases</a>
{{#if errors.length}}<div class="mb-4 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800" role="alert"><ul class="list-disc pl-5">{{#each errors}}<li>{{this}}</li>{{/each}}</ul></div>{{/if}}
<form method="POST" action="/crm/cases" class="grid max-w-3xl grid-cols-1 gap-4 rounded-xl border border-slate-200 bg-white p-5 shadow-sm sm:grid-cols-2">
  <input type="hidden" name="_csrf" value="{{csrfToken}}">
  <div class="sm:col-span-2"><h2 class="font-semibold">Open a case for a customer</h2><p class="text-xs text-slate-500">For a customer who phoned, walked in or wrote to us. The contact is added to their interaction timeline and they are notified if they have a portal account.</p></div>
  <div class="sm:col-span-2"><label class="text-sm font-medium text-slate-700" for="customer_id">Customer</label>
    <select id="customer_id" name="customer_id" required class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm"><option value="">Choose a customer…</option>{{#each customers}}<option value="{{id}}" {{#if sel}}selected{{/if}}>{{name}} ({{customer_no}})</option>{{/each}}</select>
    <p class="mt-1 text-xs text-slate-500">Only customers in your scope are listed. <a href="/crm/customers/new" class="text-violet-700 hover:underline">New customer</a></p></div>
  <div><label class="text-sm font-medium text-slate-700" for="channel">Contacted us by</label><select id="channel" name="channel" required class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm">{{#each channelOptions}}<option value="{{value}}" {{#if sel}}selected{{/if}}>{{label}}</option>{{/each}}</select></div>
  <div><label class="text-sm font-medium text-slate-700" for="case_type">Type of concern</label><select id="case_type" name="case_type" required class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm">{{#each typeOptions}}<option value="{{value}}" {{#if sel}}selected{{/if}}>{{label}}</option>{{/each}}</select></div>
  <div><label class="text-sm font-medium text-slate-700" for="category_id">Category</label><select id="category_id" name="category_id" required class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm"><option value="">Choose…</option>{{#each categories}}<option value="{{id}}" {{#if sel}}selected{{/if}}>{{name}}</option>{{/each}}</select></div>
  <div><label class="text-sm font-medium text-slate-700" for="priority">Priority</label><select id="priority" name="priority" required class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm">{{#each priorityOptions}}<option value="{{value}}" {{#if sel}}selected{{/if}}>{{label}}</option>{{/each}}</select></div>
  <div class="sm:col-span-2"><label class="text-sm font-medium text-slate-700" for="subject">Subject</label><input id="subject" name="subject" value="{{form.subject}}" required minlength="5" maxlength="150" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm"></div>
  <div class="sm:col-span-2"><label class="text-sm font-medium text-slate-700" for="description">Details</label><textarea id="description" name="description" rows="5" required minlength="15" maxlength="5000" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm">{{form.description}}</textarea></div>
  <div><label class="text-sm font-medium text-slate-700" for="order_reference">Order / receipt no.</label><input id="order_reference" name="order_reference" value="{{form.order_reference}}" maxlength="60" placeholder="e.g. ORD-10452 or OR-00871" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm"></div>
  {{#if canPickAgent}}
  <div><label class="text-sm font-medium text-slate-700" for="agent_id">Assign to an agent (optional)</label><select id="agent_id" name="agent_id" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm"><option value="">Leave in the Customer Queue</option>{{#each agents}}<option value="{{id}}" {{#if sel}}selected{{/if}}>{{name}} — {{team_name}} · {{active_count}} active</option>{{/each}}</select></div>
  {{else}}<p class="self-end text-xs text-slate-500">The case will be assigned to you.</p>{{/if}}
  <div class="flex flex-wrap gap-2 sm:col-span-2"><button class="rounded-lg bg-violet-700 px-4 py-2 text-sm font-medium text-white hover:bg-violet-800">Open case</button><a href="/crm/cases" class="rounded-lg border border-slate-300 px-4 py-2 text-sm hover:bg-slate-50">Cancel</a></div>
</form>
{{> layout_bottom}}
