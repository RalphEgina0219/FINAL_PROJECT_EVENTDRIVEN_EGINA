{{> layout_top}}
<p class="mb-4 text-sm text-slate-500">{{#if isManager}}Every escalated case. Level 2 cases are yours; level 1 cases belong to the Team Leader but you can act on them.{{else}}Level 1 escalations from your team's agents.{{/if}}</p>
<section class="rounded-xl border border-slate-200 bg-white shadow-sm">
  {{#if rows.length}}
  <div class="overflow-x-auto">
  <table class="stack min-w-full text-sm">
    <thead class="bg-slate-50 text-left text-xs font-medium uppercase tracking-wide text-slate-500">
      <tr><th class="px-4 py-2">Case</th><th class="px-4 py-2">Customer</th><th class="px-4 py-2">Level</th><th class="px-4 py-2">Escalated by</th><th class="px-4 py-2">Reason</th><th class="px-4 py-2">Waiting</th></tr>
    </thead>
    <tbody class="divide-y divide-slate-100">
    {{#each rows}}
      <tr class="hover:bg-slate-50">
        <td class="px-4 py-3"><a href="/crm/cases/{{id}}" class="font-medium text-violet-700 hover:underline">{{case_no}}</a> {{priorityBadge priority}}<p class="max-w-xs truncate text-slate-600">{{subject}}</p></td>
        <td class="whitespace-nowrap px-4 py-3">{{customer_name}}<p class="text-xs text-slate-500">{{team_name}}</p></td>
        <td class="whitespace-nowrap px-4 py-3"><span class="rounded-full bg-rose-50 px-2 py-0.5 text-xs font-medium text-rose-700">{{escalation_level}} · {{levelLabel escalation_level}}</span></td>
        <td class="whitespace-nowrap px-4 py-3">{{escalated_by_name}}</td>
        <td class="px-4 py-3 text-slate-600">{{reason}}</td>
        <td class="whitespace-nowrap px-4 py-3 text-slate-500" title="{{formatDateTime escalated_at}}">{{timeAgo escalated_at}}</td>
      </tr>
    {{/each}}
    </tbody>
  </table>
  </div>
  {{else}}<p class="px-6 py-10 text-center text-sm text-slate-500">No pending escalations.</p>{{/if}}
</section>
{{> layout_bottom}}
