{{> layout_top}}
{{> area_tabs}}
{{> inventory_note}}
{{#if errors.length}}<div class="mb-4 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800" role="alert"><ul class="list-disc pl-5">{{#each errors}}<li>{{this}}</li>{{/each}}</ul></div>{{/if}}
<form method="POST" action="/crm/promotions" class="grid max-w-3xl grid-cols-1 gap-4 rounded-xl border border-slate-200 bg-white p-5 shadow-sm sm:grid-cols-2">
  <input type="hidden" name="_csrf" value="{{csrfToken}}">
  <h2 class="font-semibold sm:col-span-2">Promotion details</h2>
  <div><label class="text-sm font-medium text-slate-700" for="promo_code">Code</label><input id="promo_code" name="promo_code" value="{{form.promo_code}}" required maxlength="20" pattern="[A-Za-z0-9]{4,20}" placeholder="PANTRY10" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 font-mono text-sm uppercase"><p class="mt-1 text-xs text-slate-500">4 to 20 letters or numbers.</p></div>
  <div><label class="text-sm font-medium text-slate-700" for="name">Name</label><input id="name" name="name" value="{{form.name}}" required minlength="3" maxlength="120" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm"></div>
  <div><label class="text-sm font-medium text-slate-700" for="promo_type">Type</label><select id="promo_type" name="promo_type" required class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm">{{#each typeOptions}}<option value="{{value}}" {{#if sel}}selected{{/if}}>{{label}}</option>{{/each}}</select></div>
  <div><label class="text-sm font-medium text-slate-700" for="value">Value (percent, or pesos)</label><input id="value" name="value" value="{{form.value}}" required inputmode="decimal" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm"></div>
  <div><label class="text-sm font-medium text-slate-700" for="applies_to">Applies to</label><select id="applies_to" name="applies_to" required class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm">{{#each appliesOptions}}<option value="{{value}}" {{#if sel}}selected{{/if}}>{{label}}</option>{{/each}}</select></div>
  <div><label class="text-sm font-medium text-slate-700" for="min_order_amount">Minimum order (optional)</label><input id="min_order_amount" name="min_order_amount" value="{{form.min_order_amount}}" inputmode="decimal" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm"></div>
  <div><label class="text-sm font-medium text-slate-700" for="product_id">Product (when it applies to one product)</label><select id="product_id" name="product_id" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm"><option value="">—</option>{{#each products}}<option value="{{product_id}}" {{#if sel}}selected{{/if}}>{{name}}</option>{{/each}}</select></div>
  <div><label class="text-sm font-medium text-slate-700" for="category_name">Category (when it applies to a category)</label><select id="category_name" name="category_name" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm"><option value="">—</option>{{#each categories}}<option value="{{name}}" {{#if sel}}selected{{/if}}>{{name}}</option>{{/each}}</select></div>
  <div><label class="text-sm font-medium text-slate-700" for="start_at">Starts</label><input id="start_at" name="start_at" type="datetime-local" value="{{form.start_at}}" required class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm"></div>
  <div><label class="text-sm font-medium text-slate-700" for="end_at">Ends</label><input id="end_at" name="end_at" type="datetime-local" value="{{form.end_at}}" required class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm"></div>
  <div><label class="text-sm font-medium text-slate-700" for="usage_limit">Usage limit (optional)</label><input id="usage_limit" name="usage_limit" value="{{form.usage_limit}}" inputmode="numeric" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm"></div>
  <div><label class="text-sm font-medium text-slate-700" for="campaign_id">Campaign (optional)</label><select id="campaign_id" name="campaign_id" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm"><option value="">—</option>{{#each campaigns}}<option value="{{id}}" {{#if sel}}selected{{/if}}>{{name}}</option>{{/each}}</select></div>
  <p class="text-xs text-slate-500 sm:col-span-2">The promotion is created as "Waiting for approval". A Team Leader (or another Manager) must approve it; you cannot approve your own.</p>
  <div class="flex flex-wrap gap-2 sm:col-span-2"><button class="rounded-lg bg-violet-700 px-4 py-2 text-sm font-medium text-white hover:bg-violet-800">Create promotion</button><a href="/crm/promotions" class="rounded-lg border border-slate-300 px-4 py-2 text-sm hover:bg-slate-50">Cancel</a></div>
</form>
{{> layout_bottom}}
