{{> layout_top}}
{{> area_tabs}}
<div class="mb-4 flex flex-wrap items-center justify-between gap-2">
  <p class="text-xs text-slate-500">A campaign groups promotions over a period. Results show only what the orders can answer (promotion uses, discount given, orders and sales). The CRM does not send SMS or email yet.</p>
  <a href="/crm/campaigns/new" class="inline-flex rounded-lg bg-violet-700 px-4 py-2 text-sm font-medium text-white hover:bg-violet-800">New campaign</a>
</div>
<form method="GET" action="/crm/campaigns" class="mb-4 flex flex-wrap items-end gap-2 rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
  <div class="min-w-0 flex-1"><label class="text-xs font-medium text-slate-500" for="q">Search</label><input id="q" name="q" value="{{filters.q}}" placeholder="Name or CMP- code" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm"></div>
  <div><label class="text-xs font-medium text-slate-500" for="status">Status</label><select id="status" name="status" class="mt-1 rounded-lg border border-slate-300 px-3 py-2 text-sm"><option value="">All</option>{{#each statusOptions}}<option value="{{value}}" {{#if sel}}selected{{/if}}>{{label}}</option>{{/each}}</select></div>
  <button class="rounded-lg bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700">Filter</button>
</form>
<section class="rounded-xl border border-slate-200 bg-white shadow-sm">
  {{#if rows.length}}
  <div class="overflow-x-auto"><table class="stack min-w-full text-sm">
    <thead class="bg-slate-50 text-left text-xs font-medium uppercase tracking-wide text-slate-500"><tr><th class="px-4 py-2">Campaign</th><th class="px-4 py-2">Channel</th><th class="px-4 py-2">Period</th><th class="px-4 py-2">Status</th><th class="px-4 py-2 text-right">Promotions</th><th class="px-4 py-2 text-right">Uses</th></tr></thead>
    <tbody class="divide-y divide-slate-100">
    {{#each rows}}
      <tr class="hover:bg-slate-50"><td class="px-4 py-3"><a href="/crm/campaigns/{{id}}" class="font-medium text-violet-700 hover:underline">{{name}}</a> {{#if is_demo}}{{demoBadge}}{{/if}}<p class="font-mono text-xs text-slate-500">{{campaign_code}}</p></td>
        <td class="px-4 py-3 text-slate-600">{{channel_label}}</td><td class="whitespace-nowrap px-4 py-3 text-slate-600">{{formatDate start_date}} – {{formatDate end_date}}</td>
        <td class="px-4 py-3">{{status_label}}</td><td class="px-4 py-3 text-right tabular-nums">{{promotion_count}}</td><td class="px-4 py-3 text-right tabular-nums">{{redemption_count}}</td></tr>
    {{/each}}
    </tbody></table></div>
  {{else}}<p class="px-6 py-10 text-center text-sm text-slate-500">No campaigns yet.</p>{{/if}}
  {{> pagination}}
</section>
{{> layout_bottom}}
