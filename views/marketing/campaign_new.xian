{{> layout_top}}
{{> area_tabs}}
{{#if errors.length}}<div class="mb-4 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800" role="alert"><ul class="list-disc pl-5">{{#each errors}}<li>{{this}}</li>{{/each}}</ul></div>{{/if}}
<form method="POST" action="/crm/campaigns" class="grid max-w-3xl grid-cols-1 gap-4 rounded-xl border border-slate-200 bg-white p-5 shadow-sm sm:grid-cols-2">
  <input type="hidden" name="_csrf" value="{{csrfToken}}">
  <h2 class="font-semibold sm:col-span-2">Campaign details</h2>
  <div class="sm:col-span-2"><label class="text-sm font-medium text-slate-700" for="name">Name</label><input id="name" name="name" value="{{form.name}}" required minlength="3" maxlength="120" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm"></div>
  <div><label class="text-sm font-medium text-slate-700" for="channel">Channel</label><select id="channel" name="channel" required class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm">{{#each channelOptions}}<option value="{{value}}" {{#if sel}}selected{{/if}}>{{label}}</option>{{/each}}</select></div>
  <div></div>
  <div><label class="text-sm font-medium text-slate-700" for="start_date">Starts</label><input id="start_date" name="start_date" type="date" value="{{form.start_date}}" required class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm"></div>
  <div><label class="text-sm font-medium text-slate-700" for="end_date">Ends</label><input id="end_date" name="end_date" type="date" value="{{form.end_date}}" required class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm"></div>
  <div class="sm:col-span-2"><label class="text-sm font-medium text-slate-700" for="description">Description (optional)</label><textarea id="description" name="description" rows="3" maxlength="1000" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm">{{form.description}}</textarea>
    <p class="mt-1 text-xs text-slate-500">The campaign starts as a draft. Add promotions to it from the Promotions page. The CRM does not send messages in this phase.</p></div>
  <div class="flex flex-wrap gap-2 sm:col-span-2"><button class="rounded-lg bg-violet-700 px-4 py-2 text-sm font-medium text-white hover:bg-violet-800">Create campaign</button><a href="/crm/campaigns" class="rounded-lg border border-slate-300 px-4 py-2 text-sm hover:bg-slate-50">Cancel</a></div>
</form>
{{> layout_bottom}}
