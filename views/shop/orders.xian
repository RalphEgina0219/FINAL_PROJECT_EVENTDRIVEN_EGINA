{{> layout_top}}
{{> area_tabs}}
<section class="rounded-xl border border-slate-200 bg-white shadow-sm">
  {{#if rows.length}}
  <div class="overflow-x-auto"><table class="stack min-w-full text-sm">
    <thead class="bg-slate-50 text-left text-xs font-medium uppercase tracking-wide text-slate-500"><tr><th class="px-4 py-2">Order</th><th class="px-4 py-2">Date</th><th class="px-4 py-2">Fulfilment</th><th class="px-4 py-2 text-right">Total</th><th class="px-4 py-2">Status</th><th class="px-4 py-2">Payment</th></tr></thead>
    <tbody class="divide-y divide-slate-100">
    {{#each rows}}<tr class="hover:bg-slate-50"><td class="px-4 py-3"><a href="/portal/orders/{{id}}" class="font-mono font-medium text-violet-700 hover:underline">{{order_no}}</a> {{#if is_demo}}{{demoBadge}}{{/if}}</td><td class="px-4 py-3 text-slate-600">{{formatDate created_at}}</td><td class="px-4 py-3 text-slate-600">{{fulfillment_label}}</td><td class="px-4 py-3 text-right tabular-nums">{{peso grand_total}}</td><td class="px-4 py-3">{{status_label}}</td><td class="px-4 py-3 text-slate-600">{{payment_label}}</td></tr>{{/each}}
    </tbody></table></div>
  {{else}}<p class="px-6 py-10 text-center text-sm text-slate-500">You have no orders yet. <a href="/portal/shop" class="text-violet-700 hover:underline">Browse the shop</a>.</p>{{/if}}
  {{> pagination}}
</section>
{{> layout_bottom}}
