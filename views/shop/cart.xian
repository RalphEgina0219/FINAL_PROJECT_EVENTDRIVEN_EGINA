{{> layout_top}}
{{> area_tabs}}
{{> inventory_note}}
{{#if cart.items.length}}
<div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
  <section class="rounded-xl border border-slate-200 bg-white shadow-sm lg:col-span-2">
    <div class="border-b border-slate-100 px-4 py-3"><h2 class="font-semibold">Items in your cart</h2><p class="text-xs text-slate-500">Prices and availability are checked with Inventory again when you place the order.</p></div>
    <ul class="divide-y divide-slate-100 text-sm">
      {{#each cart.items}}
      <li class="px-4 py-3"><div class="flex flex-wrap items-center justify-between gap-2">
        <span><span class="font-medium">{{name}}</span><br><span class="text-xs text-slate-500">{{peso price_now}} / {{unit}}</span></span>
        <span class="flex items-center gap-2">
          <form method="POST" action="/portal/cart/update" class="flex items-center gap-1"><input type="hidden" name="_csrf" value="{{@root.csrfToken}}"><input type="hidden" name="product_id" value="{{product_id}}"><input name="quantity" value="{{quantity}}" inputmode="decimal" aria-label="Quantity of {{name}}" class="w-20 rounded-lg border border-slate-300 px-2 py-1 text-right text-sm"><button class="text-xs text-violet-700 hover:underline">Update</button></form>
          <form method="POST" action="/portal/cart/remove"><input type="hidden" name="_csrf" value="{{@root.csrfToken}}"><input type="hidden" name="product_id" value="{{product_id}}"><button class="text-xs text-red-600 hover:underline">Remove</button></form>
          <span class="w-24 text-right font-medium tabular-nums">{{peso line_total}}</span></span></div>
        {{#each problems}}<p class="mt-1 text-xs font-medium text-red-600">{{this}}</p>{{/each}}</li>
      {{/each}}
    </ul>
    <div class="flex items-center justify-between border-t border-slate-200 px-4 py-3"><span class="font-semibold">Total before promo</span><span class="text-lg font-semibold tabular-nums">{{peso cart.total}}</span></div>
    {{#if cart.issues}}<p class="border-t border-red-100 bg-red-50 px-4 py-3 text-sm text-red-800">Some items changed. Review the notes above. If a price changed, placing the order will show the current price so you can confirm it.</p>{{/if}}
  </section>
  <section class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
    <h2 class="font-semibold">Checkout</h2>
    <form method="POST" action="/portal/cart/checkout" class="mt-3 space-y-3">
      <input type="hidden" name="_csrf" value="{{csrfToken}}"><input type="hidden" name="request_key" value="{{requestKey}}">
      <div><label class="text-sm font-medium text-slate-700" for="fulfillment">Pickup or delivery</label><select id="fulfillment" name="fulfillment" required class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm"><option value="pickup">Store pickup</option><option value="delivery">Delivery</option></select></div>
      <div><label class="text-sm font-medium text-slate-700" for="address_id">Delivery address</label><select id="address_id" name="address_id" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm"><option value="">Not for delivery</option>{{#each addresses}}<option value="{{id}}" {{#if sel}}selected{{/if}}>{{#if label}}{{label}}: {{/if}}{{line1}}{{#if city_municipality}}, {{city_municipality}}{{/if}}</option>{{/each}}</select>{{#unless addresses.length}}<p class="mt-1 text-xs text-amber-700">Add an address in My Profile to choose delivery.</p>{{/unless}}</div>
      <div><label class="text-sm font-medium text-slate-700" for="promo_code">Promo code</label><input id="promo_code" name="promo_code" maxlength="30" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 font-mono text-sm uppercase">{{#if promos.length}}<p class="mt-1 text-xs text-slate-500">Running: {{#each promos}}<span class="font-mono">{{promo_code}}</span>{{#unless @last}}, {{/unless}}{{/each}}</p>{{/if}}</div>
      <div data-loyalty-redeem="1"><label class="text-sm font-medium text-slate-700" for="loyalty_points">Use loyalty points</label><select id="loyalty_points" name="loyalty_points" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm"><option value="0">Don't use points</option>{{#each loyalty.options}}<option value="{{value}}">{{label}}</option>{{/each}}</select><p class="mt-1 text-xs text-slate-500">You have <strong>{{loyalty.balance}}</strong> point(s). {{loyaltyRules}}</p></div>
      <div><label class="text-sm font-medium text-slate-700" for="payment_method">How will you pay?</label><select id="payment_method" name="payment_method" required class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm">{{#each methodOptions}}<option value="{{value}}">{{label}}</option>{{/each}}</select></div>
      <div><label class="text-sm font-medium text-slate-700" for="payment_reference">GCash / Maya reference number</label><input id="payment_reference" name="payment_reference" maxlength="40" placeholder="Needed for GCash and Maya" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 font-mono text-sm"><p class="mt-1 text-xs text-slate-500">Send the payment in your GCash or Maya app, then type the reference number here. We check it before your order is complete. For cash on delivery, leave it empty.</p></div>
      <button class="w-full rounded-lg bg-violet-700 px-4 py-2.5 text-sm font-medium text-white hover:bg-violet-800">Place order</button>
    </form>
  </section>
</div>
{{else}}
<p class="rounded-xl border border-slate-200 bg-white px-6 py-10 text-center text-sm text-slate-500">Your cart is empty. <a href="/portal/shop" class="text-violet-700 hover:underline">Browse the shop</a>.</p>
{{/if}}
{{> layout_bottom}}
