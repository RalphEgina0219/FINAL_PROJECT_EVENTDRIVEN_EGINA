{{> layout_top}}
{{> area_tabs}}
{{> inventory_note}}
{{#if promos.length}}<div class="mb-4 rounded-lg border border-violet-200 bg-violet-50 px-4 py-3 text-sm text-violet-900"><strong>Promotions running:</strong> {{#each promos}}<span class="mr-3"><span class="font-mono font-semibold">{{promo_code}}</span> {{name}}</span>{{/each}}<span class="text-xs">Enter the code in your cart.</span></div>{{/if}}
<form method="GET" action="/portal/shop" class="mb-4 flex flex-wrap items-end gap-2 rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
  <div class="min-w-0 flex-1"><label class="text-xs font-medium text-slate-500" for="q">Search products</label><input id="q" name="q" value="{{q}}" placeholder="Name or SKU" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm"></div>
  <div><label class="text-xs font-medium text-slate-500" for="category">Category</label><select id="category" name="category" class="mt-1 rounded-lg border border-slate-300 px-3 py-2 text-sm"><option value="">All</option>{{#each categories}}<option value="{{name}}" {{#if sel}}selected{{/if}}>{{name}}</option>{{/each}}</select></div>
  <button class="rounded-lg bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700">Search</button>
</form>
{{#if products.length}}
<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
  {{#each products}}
  <article class="flex flex-col rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
    <p class="text-xs uppercase tracking-wide text-slate-500">{{category_name}}</p>
    <h2 class="mt-1 font-semibold text-slate-900">{{name}}</h2>
    <p class="mt-1 text-lg font-semibold tabular-nums">{{peso selling_price}} <span class="text-xs font-normal text-slate-500">/ {{unit}}</span></p>
    <p class="mt-1 text-sm {{#if out}}text-red-600{{else}}{{#if low_stock}}text-amber-700{{else}}text-emerald-700{{/if}}{{/if}}">{{#if out}}Out of stock{{else}}{{#if low_stock}}Only {{available_qty}} left{{else}}In stock{{/if}}{{/if}}</p>
    <form method="POST" action="/portal/cart/add" class="mt-3 flex items-center gap-2"><input type="hidden" name="_csrf" value="{{@root.csrfToken}}"><input type="hidden" name="product_id" value="{{product_id}}"><input type="hidden" name="back" value="/portal/shop">
      <input name="quantity" value="1" inputmode="decimal" {{#if out}}disabled{{/if}} aria-label="Quantity of {{name}}" class="w-20 rounded-lg border border-slate-300 px-2 py-1.5 text-right text-sm">
      <button {{#if out}}disabled{{/if}} class="rounded-lg bg-violet-700 px-3 py-1.5 text-sm font-medium text-white hover:bg-violet-800 disabled:cursor-not-allowed disabled:bg-slate-300">Add to cart</button></form>
  </article>
  {{/each}}
</div>
{{else}}<p class="rounded-xl border border-slate-200 bg-white px-6 py-10 text-center text-sm text-slate-500">No products match your search.</p>{{/if}}
{{> layout_bottom}}
