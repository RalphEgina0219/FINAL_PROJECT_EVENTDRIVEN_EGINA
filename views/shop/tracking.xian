{{> layout_top}}
{{> area_tabs}}
{{#if orders.length}}
<div class="space-y-4">
  {{#each orders}}
  <section class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
    <div class="flex flex-wrap items-center justify-between gap-2"><a href="/portal/orders/{{id}}" class="font-mono font-semibold text-violet-700 hover:underline">{{order_no}}</a><span class="text-sm text-slate-600">{{status_label}} · {{peso grand_total}} · {{fulfillment_label}}</span></div>
    <ol class="mt-3 grid grid-cols-1 gap-2 text-sm sm:grid-cols-5">{{#each steps}}<li class="rounded-lg border px-3 py-2 {{#if done}}{{#if cancelled}}border-red-200 bg-red-50 text-red-800{{else}}border-emerald-200 bg-emerald-50 text-emerald-800{{/if}}{{else}}border-slate-200 text-slate-400{{/if}}">{{#if done}}✓{{else}}○{{/if}} {{label}}{{#if at}}<span class="block text-xs">{{formatDateTime at}}</span>{{/if}}</li>{{/each}}</ol>
  </section>
  {{/each}}
</div>
{{else}}<p class="rounded-xl border border-slate-200 bg-white px-6 py-10 text-center text-sm text-slate-500">You have no orders to track yet. <a href="/portal/shop" class="text-violet-700 hover:underline">Browse the shop</a>.</p>{{/if}}
{{> layout_bottom}}
