{{> head}}
<body class="jvz-hero min-h-screen font-sans text-blue-100 antialiased">
<div class="mx-auto flex min-h-screen max-w-5xl flex-col px-4 py-8 sm:px-6">
  <header class="flex items-center justify-between">
    <div class="flex items-center gap-2"><span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-white p-0.5"><img src="/images/logo-mark.png" alt="JOHNVIVZ logo" class="h-full w-full object-contain"></span><span class="text-lg font-extrabold tracking-tight text-white">JOHNVIVZ <span class="text-brand-300">CRM</span></span></div>
    {{#if currentUser}}<a href="/dashboard" class="rounded-lg bg-violet-600 px-4 py-2 text-sm font-medium text-white hover:bg-violet-700">Go to dashboard</a>
    {{else}}<a href="/login" class="rounded-lg bg-violet-600 px-4 py-2 text-sm font-medium text-white hover:bg-violet-700">Sign in</a>{{/if}}
  </header>
  <main class="flex flex-1 flex-col justify-center py-16">
    <p class="text-sm font-semibold uppercase tracking-wider text-violet-400">JOHNVIVZ Grocery · Customer Relationship Management</p>
    <h1 class="mt-3 max-w-2xl text-4xl font-semibold leading-tight text-white sm:text-5xl">JOHNVIVZ CRM</h1>
    <p class="mt-4 max-w-xl text-blue-100/80">Customer profiles, inquiries, complaints and service cases in one place, with a customer portal to submit concerns, track them and rate the service.</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/register" class="rounded-lg bg-white px-5 py-2.5 font-medium text-slate-900 hover:bg-slate-100">Create a customer account</a>
      <a href="/login" class="rounded-lg border border-slate-600 px-5 py-2.5 font-medium text-white hover:bg-white/10">Sign in</a>
    </div>
    <div class="mt-14 grid gap-4 sm:grid-cols-3">
      <div class="rounded-xl border border-white/15 bg-white/5 p-4"><p class="font-medium text-white">Customer portal</p><p class="mt-1 text-sm text-blue-100/80">Submit inquiries and complaints, follow every update and rate the service.</p></div>
      <div class="rounded-xl border border-white/15 bg-white/5 p-4"><p class="font-medium text-white">Case handling</p><p class="mt-1 text-sm text-blue-100/80">Open → Assigned → In Progress → Resolved → Closed, with escalation Agent → Team Leader → CRM Manager.</p></div>
      <div class="rounded-xl border border-white/15 bg-white/5 p-4"><p class="font-medium text-white">Connected ecosystem</p><p class="mt-1 text-sm text-blue-100/80">Staff from JOHNVIVZ HR; products and stock from Inventory; completed sales to Accounting.</p></div>
    </div>
  </main>
  <p class="text-center text-xs text-slate-500">Ralph Kenneth Egina · BSIT 3-F1 · Built with XianFire Framework</p>
</div>
</body>
</html>
