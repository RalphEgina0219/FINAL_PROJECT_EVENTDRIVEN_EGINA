{{#if currentUser}}{{> layout_top}}{{else}}{{> head}}<body class="min-h-screen bg-slate-50 font-sans text-slate-800 antialiased"><main class="px-4 py-16">{{/if}}
<div class="mx-auto max-w-lg rounded-2xl border border-slate-200 bg-white p-8 text-center shadow-sm">
  <p class="text-5xl font-semibold text-slate-300">{{status}}</p>
  <h2 class="mt-2 text-xl font-semibold text-slate-900">{{title}}</h2>
  <p class="mt-2 text-sm text-slate-600">{{message}}</p>
  <div class="mt-6 flex justify-center gap-3 text-sm">
    <a href="javascript:history.back()" class="rounded-lg border border-slate-300 px-4 py-2 hover:bg-slate-50">Go back</a>
    <a href="{{#if currentUser}}{{dashboardPath}}{{else}}/login{{/if}}" class="rounded-lg bg-violet-700 px-4 py-2 font-medium text-white hover:bg-violet-800">{{#if currentUser}}Dashboard{{else}}Sign in{{/if}}</a>
  </div>
</div>
{{#if currentUser}}{{> layout_bottom}}{{else}}</main></body></html>{{/if}}
