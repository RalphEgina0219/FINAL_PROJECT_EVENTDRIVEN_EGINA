{{> layout_top}}
{{#unless isManager}}<p class="mb-3 text-sm text-slate-500">Showing <strong>{{teamName}}</strong> only. Team Leaders see their own team.</p>{{/unless}}
<form method="GET" action="/crm/reports" class="mb-4 grid gap-3 rounded-xl border border-slate-200 bg-white p-4 shadow-sm sm:grid-cols-2 lg:grid-cols-7">
  <div><label class="text-xs font-medium text-slate-500" for="from">From</label><input id="from" type="date" name="from" value="{{filters.from}}" class="mt-1 w-full rounded-lg border border-slate-300 px-2 py-2 text-sm"></div>
  <div><label class="text-xs font-medium text-slate-500" for="to">To</label><input id="to" type="date" name="to" value="{{filters.to}}" class="mt-1 w-full rounded-lg border border-slate-300 px-2 py-2 text-sm"></div>
  <div><label class="text-xs font-medium text-slate-500" for="category_id">Category</label><select id="category_id" name="category_id" class="mt-1 w-full rounded-lg border border-slate-300 px-2 py-2 text-sm"><option value="">All</option>{{#each categories}}<option value="{{id}}" {{selected ../filters.category_id id}}>{{name}}</option>{{/each}}</select></div>
  <div><label class="text-xs font-medium text-slate-500" for="priority">Priority</label><select id="priority" name="priority" class="mt-1 w-full rounded-lg border border-slate-300 px-2 py-2 text-sm"><option value="">All</option>{{#each priorityOptions}}<option value="{{value}}" {{selected ../filters.priority value}}>{{label}}</option>{{/each}}</select></div>
  <div><label class="text-xs font-medium text-slate-500" for="agent">Agent</label><select id="agent" name="agent" class="mt-1 w-full rounded-lg border border-slate-300 px-2 py-2 text-sm"><option value="">All</option>{{#each agents}}<option value="{{id}}" {{selected ../filters.agent id}}>{{name}}</option>{{/each}}</select></div>
  <div><label class="text-xs font-medium text-slate-500" for="status">Status</label><select id="status" name="status" class="mt-1 w-full rounded-lg border border-slate-300 px-2 py-2 text-sm"><option value="">All</option>{{#each statusOptions}}<option value="{{value}}" {{selected ../filters.status value}}>{{label}}</option>{{/each}}</select></div>
  {{#if isManager}}<div><label class="text-xs font-medium text-slate-500" for="team">Team</label><select id="team" name="team" class="mt-1 w-full rounded-lg border border-slate-300 px-2 py-2 text-sm"><option value="">All teams</option>{{#each teams}}<option value="{{id}}" {{selected ../filters.team id}}>{{name}}</option>{{/each}}</select></div>{{/if}}
  <div><label class="text-xs font-medium text-slate-500" for="period">View</label><select id="period" name="period" class="mt-1 w-full rounded-lg border border-slate-300 px-2 py-2 text-sm"><option value="daily" {{selected filters.period "daily"}}>Daily</option><option value="weekly" {{selected filters.period "weekly"}}>Weekly</option><option value="monthly" {{selected filters.period "monthly"}}>Monthly</option></select></div>
  <div class="flex flex-wrap items-end gap-2 sm:col-span-2 lg:col-span-7">
    <button class="rounded-lg bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700">Apply filters</button>
    <a href="/crm/reports" class="rounded-lg border border-slate-300 px-4 py-2 text-sm hover:bg-slate-50">Reset</a>
    <span class="ml-auto text-xs text-slate-500">Export with these filters:</span>
    <a href="/crm/reports/export/pdf?{{qs}}" class="inline-flex items-center gap-1 rounded-lg border border-slate-300 px-3 py-2 text-sm hover:bg-slate-50">{{icon "download" "h-4 w-4"}} PDF</a>
    <a href="/crm/reports/export/xlsx?{{qs}}" class="inline-flex items-center gap-1 rounded-lg border border-slate-300 px-3 py-2 text-sm hover:bg-slate-50">{{icon "download" "h-4 w-4"}} Excel</a>
    <a href="/crm/reports/export/csv?{{qs}}" class="inline-flex items-center gap-1 rounded-lg border border-slate-300 px-3 py-2 text-sm hover:bg-slate-50">{{icon "download" "h-4 w-4"}} CSV</a>
  </div>
</form>

{{#if report.kpi.demo_count}}<div class="mb-4 flex items-start gap-2 rounded-lg border border-dashed border-sky-300 bg-sky-50 px-4 py-2 text-sm text-sky-800">{{icon "beaker" "h-5 w-5 shrink-0"}} Computed live from the database. {{report.kpi.demo_count}} of {{report.kpi.total}} cases in this report are demo records.</div>{{/if}}

<div class="grid grid-cols-2 gap-4 lg:grid-cols-4">
  <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm"><p class="text-xs font-medium uppercase tracking-wide text-slate-500">Total cases</p><p class="mt-1 text-3xl font-semibold tabular-nums">{{number report.kpi.total}}</p><p class="text-xs text-slate-500">{{report.kpi.active}} active · {{report.kpi.resolved}} resolved/closed</p></div>
  <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm"><p class="text-xs font-medium uppercase tracking-wide text-slate-500">Avg. first response</p><p class="mt-1 text-3xl font-semibold">{{duration report.kpi.avg_first_response}}</p><p class="text-xs text-slate-500">SLA met: {{#if report.kpi.responded}}{{report.kpi.sla_first_response_pct}}%{{else}}—{{/if}}</p></div>
  <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm"><p class="text-xs font-medium uppercase tracking-wide text-slate-500">Avg. resolution time</p><p class="mt-1 text-3xl font-semibold">{{duration report.kpi.avg_resolution}}</p><p class="text-xs text-slate-500">SLA met: {{#if report.kpi.resolved_measured}}{{report.kpi.sla_resolution_pct}}%{{else}}—{{/if}}</p></div>
  <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm"><p class="text-xs font-medium uppercase tracking-wide text-slate-500">CSAT</p><p class="mt-1 text-3xl font-semibold">{{#if report.csat.total}}{{fixed report.csat.avg 1}}<span class="text-base text-slate-400">/5</span>{{else}}—{{/if}}</p><p class="text-xs text-slate-500">{{report.csat.total}} rating(s){{#if report.csat.total}} · {{report.csat.satisfied_pct}}% satisfied{{/if}}</p></div>
  <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm"><p class="text-xs font-medium uppercase tracking-wide text-slate-500">Resolution rate</p><p class="mt-1 text-2xl font-semibold">{{#if report.kpi.total}}{{report.kpi.resolution_rate}}%{{else}}—{{/if}}</p></div>
  <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm"><p class="text-xs font-medium uppercase tracking-wide text-slate-500">SLA compliance</p><p class="mt-1 text-2xl font-semibold">{{#if report.kpi.resolved_measured}}{{report.kpi.sla_resolution_pct}}%{{else}}—{{/if}}</p><p class="text-xs text-slate-500">resolved within target</p></div>
  <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm"><p class="text-xs font-medium uppercase tracking-wide text-slate-500">Reopen rate</p><p class="mt-1 text-2xl font-semibold">{{#if report.kpi.total}}{{report.kpi.reopen_rate}}%{{else}}—{{/if}}</p><p class="text-xs text-slate-500">{{report.kpi.reopened_cases}} case(s) reopened</p></div>
  <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm"><p class="text-xs font-medium uppercase tracking-wide text-slate-500">Overdue now</p><p class="mt-1 text-2xl font-semibold {{#if report.kpi.overdue}}text-red-600{{/if}}">{{report.kpi.overdue}}</p></div>
</div>

<div class="mt-6 grid grid-cols-1 gap-6 xl:grid-cols-3">
  <section class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm xl:col-span-2">
    <h2 class="font-semibold">Cases created vs. resolved ({{filters.period}})</h2>
    {{#if report.trend.length}}<div class="relative mt-3 h-72"><canvas id="trendChart" role="img" aria-label="Line chart of cases created and resolved per period. The same numbers are in the trend table below."></canvas></div>
    {{else}}<p class="py-16 text-center text-sm text-slate-500">No cases in this period.</p>{{/if}}
  </section>
  <section class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
    <h2 class="mb-3 font-semibold">Top 5 complaint categories</h2>
    {{> bars rows=report.topComplaints max=maxComplaints}}
  </section>
</div>

<div class="mt-6 grid grid-cols-1 gap-6 lg:grid-cols-2">
  <section class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
    <h2 class="font-semibold">Cases by category</h2>
    {{#if report.byCategory.length}}<div class="relative mt-3 h-72"><canvas id="categoryChart" role="img" aria-label="Bar chart of cases per category. The same numbers are in the category table."></canvas></div>{{else}}<p class="py-10 text-center text-sm text-slate-500">No data.</p>{{/if}}
  </section>
  <section class="grid grid-cols-1 gap-6 sm:grid-cols-2">
    <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm"><h2 class="mb-3 font-semibold">By priority</h2>{{> bars rows=byPriority max=maxPriority labelKey="label"}}</div>
    <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm"><h2 class="mb-3 font-semibold">By status</h2>{{> bars rows=byStatus max=maxStatus}}</div>
    <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm"><h2 class="mb-3 font-semibold">By case type</h2>{{> bars rows=byType max=maxType}}</div>
    <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm"><h2 class="mb-3 font-semibold">CSAT distribution</h2>
      <ul class="space-y-2">{{#each report.csat.distribution}}<li class="flex items-center gap-2 text-sm" title="{{rating}} star: {{total}}"><span class="w-10">{{rating}} ★</span><div class="h-2 flex-1 rounded-full bg-slate-100"><div class="h-2 rounded-full bg-amber-400" style="width: {{barWidth total ../maxCsat}}%"></div></div><span class="w-6 text-right tabular-nums">{{total}}</span></li>{{/each}}</ul></div>
  </section>
</div>

<section class="mt-6 overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm">
  <div class="border-b border-slate-100 px-4 py-3"><h2 class="font-semibold">Agent performance</h2></div>
  {{#if report.agents.length}}
  <table class="stack min-w-full text-sm">
    <thead class="bg-slate-50 text-left text-xs font-medium uppercase tracking-wide text-slate-500"><tr><th class="px-4 py-2">Agent</th><th class="px-4 py-2">Team</th><th class="px-4 py-2 text-right">Handled</th><th class="px-4 py-2 text-right">Resolved</th><th class="px-4 py-2 text-right">Overdue</th><th class="px-4 py-2 text-right">Avg first response</th><th class="px-4 py-2 text-right">Avg resolution</th><th class="px-4 py-2 text-right">Avg rating</th></tr></thead>
    <tbody class="divide-y divide-slate-100 tabular-nums">{{#each report.agents}}<tr><td class="px-4 py-2 font-medium">{{name}}</td><td class="px-4 py-2 text-slate-500">{{team_name}}</td><td class="px-4 py-2 text-right">{{handled}}</td><td class="px-4 py-2 text-right">{{resolved}}</td><td class="px-4 py-2 text-right">{{overdue}}</td><td class="px-4 py-2 text-right">{{duration avg_first_response}}</td><td class="px-4 py-2 text-right">{{duration avg_resolution}}</td><td class="px-4 py-2 text-right">{{#if ratings}}{{fixed avg_rating 1}} ★ ({{ratings}}){{else}}—{{/if}}</td></tr>{{/each}}</tbody>
  </table>
  {{else}}<p class="px-6 py-8 text-center text-sm text-slate-500">No assigned cases in this period.</p>{{/if}}
</section>

<div class="mt-6 grid grid-cols-1 gap-6 lg:grid-cols-2">
  <section class="overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm">
    <div class="border-b border-slate-100 px-4 py-3"><h2 class="font-semibold">Category table</h2></div>
    <table class="stack min-w-full text-sm"><thead class="bg-slate-50 text-left text-xs uppercase text-slate-500"><tr><th class="px-4 py-2">Category</th><th class="px-4 py-2 text-right">Cases</th><th class="px-4 py-2 text-right">Resolved</th></tr></thead>
      <tbody class="divide-y divide-slate-100 tabular-nums">{{#each report.byCategory}}<tr><td class="px-4 py-2">{{name}}</td><td class="px-4 py-2 text-right">{{total}}</td><td class="px-4 py-2 text-right">{{resolved}}</td></tr>{{else}}<tr><td colspan="3" class="px-4 py-6 text-center text-slate-500">No data.</td></tr>{{/each}}</tbody></table>
  </section>
  <section class="overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm">
    <div class="border-b border-slate-100 px-4 py-3"><h2 class="font-semibold">Trend table</h2></div>
    <div class="max-h-80 overflow-y-auto"><table class="stack min-w-full text-sm"><thead class="sticky top-0 bg-slate-50 text-left text-xs uppercase text-slate-500"><tr><th class="px-4 py-2">Period</th><th class="px-4 py-2 text-right">Created</th><th class="px-4 py-2 text-right">Resolved</th></tr></thead>
      <tbody class="divide-y divide-slate-100 tabular-nums">{{#each report.trend}}<tr><td class="px-4 py-2">{{period}}</td><td class="px-4 py-2 text-right">{{created}}</td><td class="px-4 py-2 text-right">{{resolved}}</td></tr>{{else}}<tr><td colspan="3" class="px-4 py-6 text-center text-slate-500">No data.</td></tr>{{/each}}</tbody></table></div>
  </section>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script id="chart-data" type="application/json">{{{chartJson}}}</script>
<script>
  (function () {
    if (!window.Chart) return;
    var data = JSON.parse(document.getElementById('chart-data').textContent);
    Chart.defaults.font.family = 'Inter, system-ui, sans-serif';
    Chart.defaults.color = '#475569';
    var grid = { color: '#e2e8f0' };
    var trend = document.getElementById('trendChart');
    if (trend) new Chart(trend, {
      type: 'line',
      data: { labels: data.trend.labels, datasets: [
        { label: 'Created', data: data.trend.created, borderColor: '#2563eb', backgroundColor: '#2563eb', borderWidth: 2, pointRadius: 4, tension: 0.25 },
        { label: 'Resolved', data: data.trend.resolved, borderColor: '#059669', backgroundColor: '#059669', borderWidth: 2, pointRadius: 4, tension: 0.25 }
      ] },
      options: { maintainAspectRatio: false, interaction: { mode: 'index', intersect: false },
        plugins: { legend: { position: 'top', align: 'end', labels: { usePointStyle: true, boxWidth: 8 } } },
        scales: { y: { beginAtZero: true, ticks: { precision: 0 }, grid: grid }, x: { grid: { display: false } } } }
    });
    var cat = document.getElementById('categoryChart');
    if (cat) new Chart(cat, {
      type: 'bar',
      data: { labels: data.category.labels, datasets: [{ label: 'Cases', data: data.category.values, backgroundColor: '#7c3aed', borderRadius: 4, maxBarThickness: 28 }] },
      options: { indexAxis: 'y', maintainAspectRatio: false, plugins: { legend: { display: false } },
        scales: { x: { beginAtZero: true, ticks: { precision: 0 }, grid: grid }, y: { grid: { display: false } } } }
    });
  })();
</script>
{{> layout_bottom}}
