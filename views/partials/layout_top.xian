{{> head}}
<body class="jvz-app min-h-screen bg-slate-50 font-sans text-slate-800 antialiased">
<div class="flex min-h-screen">
  <aside id="sidebar" class="jvz-sidebar fixed inset-y-0 left-0 z-40 flex w-64 -translate-x-full flex-col text-blue-100/80 transition-transform duration-200 lg:sticky lg:top-0 lg:h-screen lg:translate-x-0">
    <div class="flex h-20 items-center gap-3 px-5">
      <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-white p-1 shadow-lg shadow-black/20"><img src="/images/logo-mark.png" alt="JOHNVIVZ logo" class="h-full w-full object-contain"></span>
      <div class="leading-tight"><p class="text-lg font-extrabold tracking-tight text-white">JOHNVIVZ <span class="text-brand-300">CRM</span></p><p class="text-[10.5px] text-blue-200/80">Serve · Sell · Retain</p></div>
    </div>
    <nav class="flex-1 overflow-y-auto px-3 py-3 text-sm" aria-label="Main">
      {{#each nav}}
        <a href="{{this.href}}" class="mb-1 flex items-center gap-3 rounded-xl px-3 py-2.5 font-medium transition {{#if this.active}}jvz-nav-active text-white{{else}}hover:bg-white/10 hover:text-white{{/if}}" {{#if this.active}}aria-current="page"{{/if}}>
          {{icon this.icon "h-5 w-5 shrink-0"}}<span class="flex-1">{{this.label}}</span>
          {{#if this.count}}<span class="rounded-full bg-rose-500 px-1.5 py-0.5 text-[10px] font-bold text-white" title="{{this.count}}">{{this.count}}</span>{{/if}}
        </a>

      {{/each}}
    </nav>
    <div class="p-4">
      <div class="jvz-compliance flex items-start gap-3 rounded-xl p-3">
        <span class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-emerald-500/20 text-emerald-300">{{icon "shieldCheck" "h-6 w-6"}}</span>
        <div class="text-xs leading-snug"><p class="font-semibold text-white">Secure &amp; Compliant</p><p class="mt-0.5 text-blue-200/80">Your data is protected under RA 10173</p></div>
      </div>
    </div>
  </aside>
  <div id="sidebar-backdrop" class="fixed inset-0 z-30 hidden bg-slate-900/50 lg:hidden"></div>

  <div class="flex min-w-0 flex-1 flex-col">
    <header class="sticky top-0 z-20 flex h-16 items-center gap-3 border-b border-slate-200/70 bg-white/90 px-4 backdrop-blur sm:px-6">
      <button id="sidebar-toggle" type="button" class="rounded-xl p-2 text-slate-600 hover:bg-slate-100 lg:hidden" aria-label="Open menu">{{icon "menu" "h-6 w-6"}}</button>
      {{#unless currentUser.isSetup}}{{#unless (eq currentUser.role "customer")}}
      <form method="GET" action="/crm/cases" role="search" class="relative hidden max-w-xl flex-1 sm:block">
        <label for="global-search" class="sr-only">Search cases</label>
        <span class="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400">{{icon "search" "h-5 w-5"}}</span>
        <input id="global-search" type="search" name="q" maxlength="80" placeholder="Search cases: number, subject, customer, order..." class="w-full rounded-xl border-0 bg-slate-100/80 py-2.5 pl-11 pr-4 text-sm placeholder:text-slate-500 focus:bg-white">
      </form>
      {{/unless}}{{/unless}}
      <span class="flex-1 sm:hidden"></span>
      <div class="ml-auto flex items-center gap-1 sm:gap-2">
        <a href="/notifications" class="relative rounded-xl p-2 text-slate-600 hover:bg-slate-100" title="Notifications" aria-label="Notifications{{#if unreadNotifications}}, {{unreadNotifications}} unread{{/if}}">
          {{icon "bell" "h-6 w-6"}}
          {{#if unreadNotifications}}<span class="absolute -right-0.5 -top-0.5 flex h-5 min-w-[1.25rem] items-center justify-center rounded-full bg-rose-500 px-1 text-[10px] font-bold text-white ring-2 ring-white">{{unreadNotifications}}</span>{{/if}}
        </a>
        <span class="mx-1 hidden h-8 w-px bg-slate-200 sm:block"></span>
        <details class="jvz-menu relative" id="user-menu">
          <summary class="flex items-center gap-3 rounded-xl p-1.5 hover:bg-slate-100" aria-label="Account menu">
            <span class="jvz-avatar flex h-9 w-9 items-center justify-center rounded-full text-sm font-semibold text-white">{{initials currentUser.name}}</span>
            <span class="hidden text-left leading-tight sm:block"><span class="block text-sm font-semibold text-slate-900">{{currentUser.name}} {{#if currentUser.is_mock}}{{mockBadge}}{{/if}} {{#if currentUser.is_demo}}{{demoBadge}}{{/if}}</span><span class="block text-xs text-slate-500">{{currentUser.roleLabel}}{{#if currentUser.team_name}} · {{currentUser.team_name}}{{/if}}</span></span>
            <span class="jvz-chevron hidden text-slate-400 transition sm:block">{{icon "chevronDown" "h-4 w-4"}}</span>
          </summary>
          <div class="absolute right-0 top-full z-30 mt-2 w-56 rounded-xl border border-slate-200 bg-white p-1.5 text-sm shadow-xl">
            <p class="px-3 py-2 text-xs text-slate-500 sm:hidden">{{currentUser.name}}<br>{{currentUser.roleLabel}}</p>
            {{#unless currentUser.isSetup}}<a href="{{#if (eq currentUser.role "customer")}}/portal{{else}}/profile{{/if}}" class="flex items-center gap-2 rounded-lg px-3 py-2 text-slate-700 hover:bg-slate-100">{{icon "user" "h-4 w-4"}} My account</a>{{/unless}}
            <form method="POST" action="/logout">
              <input type="hidden" name="_csrf" value="{{csrfToken}}">
              <button type="submit" class="flex w-full items-center gap-2 rounded-lg px-3 py-2 text-left text-slate-700 hover:bg-slate-100" title="Sign out">{{icon "logout" "h-4 w-4"}} Sign out</button>
            </form>
          </div>
        </details>
      </div>
    </header>
    <main class="jvz-main flex-1 px-4 py-6 sm:px-6 lg:px-8">
      {{#if welcome}}
      <section class="jvz-banner mb-6 px-6 py-6 sm:px-8 sm:py-7" aria-label="Welcome">
        <h1 class="text-2xl font-bold tracking-tight sm:text-3xl"><span aria-hidden="true">👋</span> Welcome back, {{firstName currentUser.name}}!</h1>
        <p class="mt-1 max-w-xl text-sm text-blue-100 sm:text-base">{{#if welcomeText}}{{welcomeText}}{{else}}Here's what's happening in your company today.{{/if}}</p>
      </section>
      {{else}}{{#unless noTitle}}
      <h1 class="mb-5 text-2xl font-bold tracking-tight text-navy-900">{{title}}</h1>
      {{/unless}}{{/if}}
      {{#if currentUser.isSetup}}
      <div class="mb-4 flex items-start gap-2 rounded-xl border border-amber-200 bg-amber-50 px-4 py-2 text-sm text-amber-900">{{icon "lock" "h-5 w-5 shrink-0"}}<span>Setup account: outside the CRM hierarchy, no access to customer records. Every change made here is written to the audit log.</span></div>
      {{/if}}
      {{> flash}}
