{{#if cases.length}}
<div class="overflow-x-auto">
<table class="stack min-w-full text-sm">
  <thead class="bg-slate-50 text-left text-xs font-medium uppercase tracking-wide text-slate-500">
    <tr><th class="px-4 py-2">Case</th>{{#if showCustomer}}<th class="px-4 py-2">Customer</th>{{/if}}<th class="px-4 py-2">Category</th><th class="px-4 py-2">Priority</th><th class="px-4 py-2">Status</th>{{#if showAgent}}<th class="px-4 py-2">Agent / team</th>{{/if}}<th class="px-4 py-2">Created</th></tr>
  </thead>
  <tbody class="divide-y divide-slate-100">
  {{#each cases}}
    <tr class="hover:bg-slate-50">
      <td class="px-4 py-3">{{#if is_unread}}<span class="mr-1 inline-block h-2 w-2 rounded-full bg-violet-500 align-middle" title="New activity"></span><span class="sr-only">New activity.</span>{{/if}}<a href="{{../base}}/{{id}}" class="{{#if is_unread}}font-semibold{{else}}font-medium{{/if}} text-violet-700 hover:underline">{{case_no}}</a> {{#if is_demo}}{{demoBadge}}{{/if}}<p class="max-w-xs truncate {{#if is_unread}}font-medium text-slate-900{{else}}text-slate-600{{/if}}">{{subject}}</p></td>
      {{#if ../showCustomer}}<td class="whitespace-nowrap px-4 py-3">{{customer_name}}<p class="text-xs text-slate-500">{{customer_no}}</p></td>{{/if}}
      <td class="whitespace-nowrap px-4 py-3 text-slate-600">{{category_name}}</td>
      <td class="px-4 py-3">{{priorityBadge priority}}</td>
      <td class="px-4 py-3"><div class="flex flex-wrap gap-1">{{statusBadge status}}{{#if (eq status "escalated")}}<span class="text-xs text-rose-700">→ {{levelLabel escalation_level}}</span>{{/if}}{{#if is_overdue}}{{overdueBadge}}{{/if}}</div></td>
      {{#if ../showAgent}}<td class="whitespace-nowrap px-4 py-3 text-slate-600">{{#if agent_name}}{{agent_name}}{{else}}<span class="text-amber-700">Unassigned</span>{{/if}}{{#if team_name}}<p class="text-xs text-slate-400">{{team_name}}</p>{{/if}}</td>{{/if}}
      <td class="whitespace-nowrap px-4 py-3 text-slate-500" title="{{formatDateTime created_at}}">{{timeAgo created_at}}</td>
    </tr>
  {{/each}}
  </tbody>
</table>
</div>
{{else}}
<div class="px-6 py-10 text-center text-sm text-slate-500">{{icon "ticket" "mx-auto mb-2 h-8 w-8 text-slate-300"}}{{#if emptyText}}{{emptyText}}{{else}}No cases yet.{{/if}}</div>
{{/if}}
