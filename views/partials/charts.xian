<div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
{{#each blocks}}
<div class="min-w-0 {{#if (eq width "half")}}lg:col-span-1{{else}}lg:col-span-2{{/if}}">
  {{#if (eq type "bars")}}
  <section class="h-full rounded-xl border border-slate-200 bg-white p-5 text-sm shadow-sm">
    <h2 class="font-semibold text-slate-900">{{title}}</h2>
    {{#if rows.length}}
    <ul class="mt-3 space-y-3">
      {{#each rows}}<li><div class="flex justify-between gap-2"><span class="truncate text-slate-700">{{label}}</span><span class="font-medium tabular-nums text-slate-900">{{display}}</span></div><div class="mt-1 h-2 rounded-full bg-slate-100"><div class="h-2 rounded-full bg-violet-500" style="width: {{size}}%"></div></div></li>{{/each}}
    </ul>
    {{else}}<p class="py-6 text-center text-slate-500">No data for this period.</p>{{/if}}
    {{#if note}}<p class="mt-3 text-xs text-slate-500">{{note}}</p>{{/if}}
  </section>
  {{/if}}
  {{#if (eq type "columns")}}
  <section class="h-full rounded-xl border border-slate-200 bg-white p-5 text-sm shadow-sm">
    <div class="flex flex-wrap items-baseline justify-between gap-2"><h2 class="font-semibold text-slate-900">{{title}}</h2>{{#if legend}}<span class="flex items-center gap-3 text-xs text-slate-500"><span class="inline-flex items-center gap-1"><span class="inline-block h-2.5 w-2.5 rounded-sm bg-violet-500"></span>Actual</span><span class="inline-flex items-center gap-1"><span class="inline-block h-2.5 w-2.5 rounded-sm border border-dashed border-amber-600 bg-amber-200"></span>Estimate</span></span>{{/if}}</div>
    <div class="mt-4 flex h-44 items-end gap-1 overflow-x-auto" role="img" aria-label="{{title}}">
      {{#each bars}}<div class="{{#if older}}hidden sm:flex{{else}}flex{{/if}} h-full min-w-[1.1rem] flex-1 flex-col text-center sm:min-w-[1.4rem]" title="{{tip}}"{{#if estimate}} data-estimate="1"{{/if}}><span class="text-[10px] tabular-nums {{#if estimate}}text-amber-700{{else}}text-slate-500{{/if}}">{{display}}</span><div class="relative mt-1 flex-1"><div class="absolute inset-x-0 bottom-0 rounded-t {{#if estimate}}border border-dashed border-amber-600 bg-amber-200{{else}}bg-violet-500{{/if}}" style="height: {{size}}%"></div></div><span class="mt-1 text-[10px] text-slate-500">{{label}}</span></div>{{/each}}
    </div>
    {{#if phoneNote}}<p class="mt-2 text-xs text-slate-400 sm:hidden">On a phone only the most recent columns are shown (forecasts: the last 7 actual days and the next 7 Estimate days).</p>{{/if}}
    {{#if note}}<p class="mt-3 text-xs text-slate-500">{{note}}</p>{{/if}}
  </section>
  {{/if}}
</div>
{{/each}}
</div>
