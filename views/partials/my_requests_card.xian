<a href="/crm/my-requests" class="flex items-center justify-between gap-3 rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm shadow-sm hover:border-violet-300" data-my-requests-card="1">
  <span><span class="font-medium text-slate-900">My Requests</span><span class="block text-xs text-slate-500">Your leave, attendance and overtime requests (a copy; filed in ESS/HR)</span></span>
  {{#if myReq.enabled}}<span class="whitespace-nowrap text-xs text-slate-600"><strong class="text-slate-900">{{myReq.open}}</strong> open · <strong class="text-slate-900">{{myReq.decided}}</strong> decided</span>{{else}}<span class="text-xs text-slate-500">Not enabled yet</span>{{/if}}
</a>
