<nav class="mb-4 flex flex-wrap gap-1 border-b border-slate-200 text-sm" aria-label="Sections">
  {{#each areaTabs}}<a href="{{href}}" class="-mb-px border-b-2 px-3 py-2 {{#if active}}border-violet-600 font-medium text-violet-700{{else}}border-transparent text-slate-600 hover:text-slate-900{{/if}}">{{label}}</a>{{/each}}
</nav>
