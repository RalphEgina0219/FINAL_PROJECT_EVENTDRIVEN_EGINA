<form method="GET" action="{{f.basePath}}" class="mb-3 flex flex-wrap items-end gap-2 rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
  <div><label class="text-xs font-medium text-slate-500" for="from">From</label><input id="from" type="date" name="from" value="{{f.from}}" class="mt-1 rounded-lg border border-slate-300 px-3 py-2 text-sm"></div>
  <div><label class="text-xs font-medium text-slate-500" for="to">To</label><input id="to" type="date" name="to" value="{{f.to}}" class="mt-1 rounded-lg border border-slate-300 px-3 py-2 text-sm"></div>
  <label class="flex items-center gap-2 pb-2 text-sm text-slate-600"><input type="checkbox" name="demo" value="1" {{#if f.includeDemo}}checked{{/if}} class="rounded border-slate-300"> Include demo data</label>
  <button class="rounded-lg bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700">Show</button>
</form>
{{#if f.includeDemo}}
<p class="mb-4 rounded-lg border border-dashed border-amber-400 bg-amber-50 px-4 py-2 text-sm text-amber-900" role="note" data-includes-demo="1"><strong>Includes demo data.</strong> These figures are not official. <a href="{{f.basePath}}?from={{f.from}}&amp;to={{f.to}}" class="underline">Show official figures</a>.</p>
{{else}}
<p class="mb-4 text-xs text-slate-500" data-official="1">Official figures: demo data, cancelled orders and voided sales are excluded; refunds are subtracted. Days are Asia/Manila days, money is in Philippine pesos.</p>
{{/if}}
